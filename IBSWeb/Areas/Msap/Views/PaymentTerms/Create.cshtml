@model IBS.Models.MasterFile.PaymentTermsViewModel

@{
    ViewData["Title"] = "Create Terms";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form asp-action="Create" method="post" id="mainForm">
        <main class="modern-container">
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Payment Terms</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">New Terms</span>
                    </div>
                    <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">payments</span>
                            <h2 class="modern-headline-md">Terms Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="flex flex-column gap-4">
                                <div>
                                    <label asp-for="TermsCode" class="modern-label">Terms Code <span class="text-error">*</span></label>
                                    <input asp-for="TermsCode" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Enter terms code" />
                                    <span asp-validation-for="TermsCode" class="text-error text-xs"></span>
                                </div>

                                <div class="modern-grid">
                                    <div class="modern-col-6">
                                        <label asp-for="NumberOfDays" class="modern-label">Number of Days <span class="text-error">*</span></label>
                                        <input asp-for="NumberOfDays" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Days" />
                                        <span asp-validation-for="NumberOfDays" class="text-error text-xs"></span>
                                    </div>
                                    <div class="modern-col-6">
                                        <label asp-for="NumberOfMonths" class="modern-label">Number of Months <span class="text-error">*</span></label>
                                        <input asp-for="NumberOfMonths" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Months" />
                                        <span asp-validation-for="NumberOfMonths" class="text-error text-xs"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
