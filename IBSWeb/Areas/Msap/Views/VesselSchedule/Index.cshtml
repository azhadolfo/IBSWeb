@{
ViewData["Title"] = "Vessel Schedule";
ViewData["IsFullWidth"] = true;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.css" />

<style>
    #gantt-container {
        width: 100%;
        overflow: hidden;
        background: #fff;
        border-radius: 8px;
    }
    #gantt-container .gantt-container {
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,0.2) transparent;
    }
    #gantt-container .gantt-container::-webkit-scrollbar { width: 8px; height: 8px; }
    #gantt-container .gantt-container::-webkit-scrollbar-track { background: transparent; }
    #gantt-container .gantt-container::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.18);
        border-radius: 9999px;
    }
    #gantt-container .gantt-container::-webkit-scrollbar-thumb:hover { background: rgba(0, 0, 0, 0.3); }
    #panel-timeline {
        min-height: 600px;
        max-height: 640px;
        overflow-y: auto;
    }
    #panel-timeline::-webkit-scrollbar { width: 8px; }
    #panel-timeline::-webkit-scrollbar-track { background: transparent; }
    #panel-timeline::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.18);
        border-radius: 9999px;
    }
    #panel-timeline::-webkit-scrollbar-thumb:hover { background: rgba(0, 0, 0, 0.3); }
    #gantt-container svg {
        display: block;
        margin: 0 auto;
    }

    .bar-wrapper.gantt-status-Tentative .bar { fill: #78909c; }
    .bar-wrapper.gantt-status-Tentative .bar-progress { fill: #607d8b; }

    .bar-wrapper.gantt-status-Confirmed .bar { fill: #1976d2; }
    .bar-wrapper.gantt-status-Confirmed .bar-progress { fill: #1565c0; }

    .bar-wrapper.gantt-status-InProgress .bar { fill: #f9a825; }
    .bar-wrapper.gantt-status-InProgress .bar-progress { fill: #f57f17; }

    .bar-wrapper.gantt-status-Completed .bar { fill: #43a047; }
    .bar-wrapper.gantt-status-Completed .bar-progress { fill: #2e7d32; }

    .bar-wrapper.gantt-status-Cancelled .bar { fill: #e53935; }
    .bar-wrapper.gantt-status-Cancelled .bar-progress { fill: #c62828; }

    #gantt-container .bar-label {
        font-size: 11px;
        font-weight: 600;
        fill: #fff;
    }
    #gantt-container .bar-wrapper.gantt-status-InProgress .bar-label,
    #gantt-container .bar-wrapper.gantt-status-Tentative .bar-label { fill: #1a1a1a; }

    .view-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 1rem;
    }
    .view-tab {
        padding: 0.5rem 1.25rem;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 500;
        border: none;
        background: none;
        color: #666;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .view-tab.active {
        color: #1976d2;
        border-bottom-color: #1976d2;
    }
    .view-tab:hover { color: #1976d2; }
    .view-panel { display: none; }
    .view-panel.active { display: block; }

    .schedule-legend {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        padding: 0.5rem 1rem;
        background: #f5f5f5;
        border-radius: 6px;
    }
    .schedule-legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
    }
    .schedule-legend-swatch {
        width: 12px;
        height: 12px;
        border-radius: 9999px;
        border: 1px solid rgba(0,0,0,0.08);
        flex-shrink: 0;
    }

    .ws-grid {
        display: flex;
        gap: 1.25rem;
        align-items: stretch;
        flex-wrap: wrap;
    }
    .gantt-col {
        flex: 3 1 480px;
        min-width: 0;
    }
    .list-col {
        flex: 1 1 320px;
        min-width: 0;
        max-width: 400px;
    }
    @@media (max-width: 1024px) {
        .list-col { max-width: none; }
    }
    .ws-entry {
        border-bottom: 1px solid var(--outline-variant);
        transition: background-color .15s ease;
    }
    .ws-entry:hover { background: var(--surface-container-low); }
    .ws-entry:last-child { border-bottom: none; }

    .ws-card-header {
        padding: 0.85rem 1.25rem;
        flex-wrap: wrap;
        row-gap: 0.65rem;
    }
    .ws-card-header .view-tab { font-size: 0.78rem; }
    .ws-card-header .view-tab .material-symbols-outlined { font-size: 17px !important; }
    .ws-card-header .schedule-legend-item { font-size: 0.75rem; }

    /* Moved out of inline style="" attributes */
    .date-range-filter {
        border: 1px solid var(--outline-variant);
        border-radius: var(--radius-lg);
        padding: 0 12px;
        height: 38px;
        background: var(--surface-container-low);
    }
    .date-range-input {
        border: none;
        background: transparent;
        height: 38px;
        padding: 0;
        font-size: 0.875rem;
        box-shadow: none;
    }
    .tug-date-input {
        height: 32px;
        padding: 0 12px;
        font-size: 0.875rem;
        border-radius: 6px;
    }
    .tug-load-btn {
        height: 32px;
        font-size: 0.8rem;
        padding: 0 12px;
    }
    .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
    }
    .ws-detail-box {
        background: var(--surface-container-low);
        border: 1px solid var(--outline-variant);
        border-radius: var(--radius-lg);
        padding: 8px 10px;
        font-size: 0.72rem;
    }
    .ws-detail-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 4px 0;
    }
    .ws-detail-row.divider {
        margin-top: 4px;
        padding-top: 6px;
        border-top: 1px solid var(--outline-variant);
    }
    .ws-detail-label { color: var(--on-surface-variant); }
    .ws-detail-value {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        font-size: 0.72rem;
    }
    .ws-vessel-name { font-weight: 700; font-size: 0.875rem; color: var(--on-surface); }
    .ws-location-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.72rem;
        color: var(--on-surface-variant);
    }
    .assignment-row { line-height: 1.6; }
</style>

<div class="modern-layout">
    <main class="modern-container">
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">Vessel Schedule</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Board</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <form method="get" class="flex items-center gap-2" id="schedule-filter">
                    <label class="modern-label mb-0" style="color: var(--on-surface-variant)">From</label>
                    <input type="date" name="from" class="modern-input" style="height: 32px; padding: 0 12px; font-size: 0.875rem; border-radius: 6px;" value="@ViewBag.From" />
                    <label class="modern-label mb-0" style="color: var(--on-surface-variant)">To</label>
                    <input type="date" name="to" class="modern-input" style="height: 32px; padding: 0 12px; font-size: 0.875rem; border-radius: 6px;" value="@ViewBag.To" />
                    <button type="submit" class="modern-btn-primary" style="height: 32px; font-size: 0.8rem; padding: 0 12px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">search</span>
                    </button>
                </form>
                <a asp-action="Create" class="modern-btn-primary" data-hotkey="c">
                    <span class="material-symbols-outlined">add_circle</span>
                    SCHEDULE
                </a>
            </div>
        </div>

        <!-- Workspace: Left timeline/tugboat pane + Right schedule sidebar -->
        <div class="ws-grid">
            <!-- Left Pane: Timeline / Tugboat View -->
            <div class="modern-card gantt-col">
                <div class="modern-card-header-action ws-card-header flex justify-between items-center gap-3 w-full">
                    <!-- View Tabs -->
                    <div class="view-tabs" style="margin:0;border:none;gap:0">
                        <button class="view-tab active" data-tab="timeline" type="button">
                            <span class="material-symbols-outlined" style="font-size:18px">schedule</span>
                            Timeline View
                        </button>
                        <button class="view-tab" data-tab="tugboats" type="button">
                            <span class="material-symbols-outlined" style="font-size:18px">directions_boat</span>
                            Tugboat View
                        </button>
                    </div>
                    <!-- Legend -->
                    <div class="schedule-legend" id="statusLegend" style="margin:0;padding:0;background:none"></div>
                </div>

                <!-- Timeline Panel -->
                <div class="modern-card-body view-panel active" id="panel-timeline">
                    <div id="gantt-container"></div>
                </div>

                <!-- Tugboat Availability Panel -->
                <div class="modern-card-body view-panel" id="panel-tugboats">
                    <div class="flex items-center justify-between gap-3 mb-3">
                        <div class="flex items-center gap-2">
                            <label class="modern-label mb-0" style="color: var(--on-surface-variant)">Date:</label>
                            <input type="date" id="tugDate" class="modern-input tug-date-input">
                            <button type="button" id="tugLoadBtn" class="modern-btn-primary tug-load-btn">
                                <span class="material-symbols-outlined" style="font-size: 16px;">refresh</span>
                            </button>
                        </div>
                        <div id="tugboat-summary" class="flex items-center gap-3"></div>
                    </div>
                    <table class="modern-table" id="tugboatTable">
                        <thead>
                        <tr>
                            <th>TUG</th>
                            <th>STATUS</th>
                            <th>ASSIGNMENTS</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr><td colspan="3" class="text-center text-muted py-4">Select a date and click refresh.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Pane: Schedule List Sidebar -->
            <div class="modern-card list-col">
                <div class="modern-card-header-action flex justify-between items-center gap-2 w-full">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">view_list</span>
                        <h6 class="modern-headline-md">Schedule List</h6>
                    </div>
                    <span class="modern-badge-sm" id="scheduleCount" style="color:var(--on-surface-variant)">0</span>
                </div>
                <div class="modern-card-body" style="overflow-y:auto;max-height:640px;padding:0;" id="scheduleSidebar"></div>
            </div>
        </div>
    </main>
</div>

<!-- Templates: markup lives in HTML, JS only binds data (no string-built HTML) -->
<template id="legendItemTemplate">
    <div class="schedule-legend-item">
        <span class="schedule-legend-swatch"></span>
        <span class="legend-label"></span>
    </div>
</template>

<template id="scheduleCardTemplate">
    <div class="ws-entry p-4" style="background:var(--surface-container-lowest);cursor:pointer">
        <div class="flex justify-between items-start gap-2 mb-2">
            <h3 class="ws-vessel-name ws-vessel"></h3>
            <span class="modern-badge-sm ws-status"></span>
        </div>
        <div class="ws-location-row">
            <span class="material-symbols-outlined" style="font-size:14px;flex-shrink:0">location_on</span>
            <span class="truncate ws-location" style="font-weight:600"></span>
        </div>
        <div class="ws-detail-box">
            <div class="ws-detail-row">
                <span class="ws-detail-label">START</span>
                <span class="ws-detail-value ws-start"></span>
            </div>
            <div class="ws-detail-row">
                <span class="ws-detail-label">END</span>
                <span class="ws-detail-value ws-end"></span>
            </div>
            <div class="ws-detail-row divider">
                <span class="ws-detail-label" style="font-size: 0.75rem">TUGS REQUIRED</span>
                <span class="ws-detail-value ws-tugs" style="font-weight:700;font-size:0.75rem"></span>
            </div>
        </div>
    </div>
</template>

<template id="tugRowStatusTemplate">
    <span class="modern-badge-sm"></span>
</template>

<template id="tugAssignmentTemplate">
    <div class="assignment-row">
        <span class="status-dot"></span>
        <strong class="assignment-time"></strong>
        <span class="assignment-vessel"></span>
        <small class="assignment-status"></small>
    </div>
</template>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.umd.js"></script>
<script>
    $(document).ready(function () {

        // ---------------------------------------------------------------
        // Single source of truth for status -> color mapping.
        // Keep in sync with the .bar-wrapper.gantt-status-* CSS above.
        // ---------------------------------------------------------------
        const STATUS_META = {
            'Tentative':   { color: '#78909c', bg: '#eceff1' },
            'Confirmed':   { color: '#1976d2', bg: '#e3f2fd' },
            'In Progress': { color: '#f9a825', bg: '#fff8e1' },
            'Completed':   { color: '#43a047', bg: '#e8f5e9' },
            'Cancelled':   { color: '#e53935', bg: '#ffebee' }
        };

        function statusMeta(status) {
            return STATUS_META[status] || STATUS_META['Tentative'];
        }

        // ---------------------------------------------------------------
        // Small fetch helper with consistent error handling
        // ---------------------------------------------------------------
        async function fetchJson(url, { errorTarget, errorMsg } = {}) {
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error(res.statusText);
                return await res.json();
            } catch (err) {
                console.error(err);
                if (errorTarget) {
                    $(errorTarget).html('<span class="text-danger">' + (errorMsg || 'Failed to load data.') + '</span>');
                }
                return null;
            }
        }

        // ---------------------------------------------------------------
        // Legend (rendered once from STATUS_META, no duplication)
        // ---------------------------------------------------------------
        function renderLegend() {
            const tpl = document.getElementById('legendItemTemplate');
            const frag = document.createDocumentFragment();
            ['Tentative', 'Confirmed', 'In Progress', 'Completed'].forEach(function (status) {
                const node = tpl.content.cloneNode(true);
                node.querySelector('.schedule-legend-swatch').style.background = statusMeta(status).color;
                node.querySelector('.legend-label').textContent = status;
                frag.appendChild(node);
            });
            document.getElementById('statusLegend').appendChild(frag);
        }
        renderLegend();

        // ---------------------------------------------------------------
        // Tab switching
        // ---------------------------------------------------------------
        $('.view-tab').on('click', function () {
            const tab = $(this).data('tab');
            $('.view-tab').removeClass('active');
            $(this).addClass('active');
            $('.view-panel').removeClass('active');
            $('#panel-' + tab).addClass('active');
            if (tab === 'tugboats' && $('#tugDate').val()) {
                loadTugboatAvailability($('#tugDate').val());
            }
        });

        // Set default date
        const today = new Date().toISOString().split('T')[0];
        $('#tugDate').val(today);

        // ---------------------------------------------------------------
        // Tugboat Availability
        // ---------------------------------------------------------------
        let tugTable = null;
        const tugRowStatusTpl = document.getElementById('tugRowStatusTemplate');
        const tugAssignmentTpl = document.getElementById('tugAssignmentTemplate');

        function buildTugStatusBadge(available) {
            const node = tugRowStatusTpl.content.cloneNode(true);
            const badge = node.querySelector('.modern-badge-sm');
            badge.textContent = available ? 'Available' : 'Busy';
            badge.classList.add(available ? 'bg-success' : 'bg-danger', 'text-white');
            return node.firstElementChild.outerHTML;
        }

        function buildTugAssignments(assignments) {
            if (!assignments || assignments.length === 0) {
                return '<span class="text-muted">&mdash;</span>';
            }
            const wrapper = document.createElement('div');
            assignments.forEach(function (a) {
                const node = tugAssignmentTpl.content.cloneNode(true);
                node.querySelector('.status-dot').style.background = statusMeta(a.status).color;
                node.querySelector('.assignment-time').textContent = a.start + ' - ' + a.end;
                node.querySelector('.assignment-vessel').textContent = ' ' + a.vesselName + ' ';
                node.querySelector('.assignment-status').textContent = '(' + a.status + ')';
                wrapper.appendChild(node);
            });
            return wrapper.innerHTML;
        }

        async function loadTugboatAvailability(date) {
            const $summary = $('#tugboat-summary');
            $summary.html('<span class="text-muted">Loading...</span>');

            if (tugTable) {
                tugTable.destroy();
                tugTable = null;
            }

            const data = await fetchJson(
                '@Url.Action("GetTugboatOccupancy", "VesselSchedule")?date=' + encodeURIComponent(date),
                { errorTarget: '#tugboat-summary', errorMsg: 'Failed to load tugboat data.' }
            );

            if (!data) return;

            if (!data.tugboats || data.tugboats.length === 0) {
                $summary.html('<span class="text-muted">No tugboats registered.</span>');
                return;
            }

            let availCount = 0, busyCount = 0;
            const rows = data.tugboats.map(function (t) {
                if (t.available) availCount++; else busyCount++;
                return [
                    t.tugboatName,
                    buildTugStatusBadge(t.available),
                    buildTugAssignments(t.assignments)
                ];
            });

            $summary.html(
                '<span class="modern-badge-sm" style="background:#4caf50;color:white">' + availCount + ' Available</span>' +
                '<span class="modern-badge-sm" style="background:#e53935;color:white">' + busyCount + ' Busy</span>'
            );

            tugTable = $('#tugboatTable').DataTable(ModernTable.config({
                serverSide: false,
                data: rows,
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: [2], searchable: false }],
                columns: [
                    { title: 'TUG' },
                    { title: 'STATUS', orderable: false },
                    { title: 'ASSIGNMENTS', orderable: false }
                ]
            }));
        }

        $('#tugDate, #tugLoadBtn').on('change click', function () {
            const date = $('#tugDate').val();
            if (date) loadTugboatAvailability(date);
        });

        // ---------------------------------------------------------------
        // Schedule Sidebar (template-based, no HTML string concatenation)
        // ---------------------------------------------------------------
        const $sidebar = $('#scheduleSidebar');
        const cardTpl = document.getElementById('scheduleCardTemplate');
        let scheduleRows = [];

        const fmt = (s) => {
            if (!s) return '';
            const d = new Date(s.replace(' ', 'T'));
            return String(d.getMonth() + 1).padStart(2, '0') + '/' +
                String(d.getDate()).padStart(2, '0') + ' ' +
                String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        };

        function renderSidebar() {
            const rows = scheduleRows;
            $('#scheduleCount').text(rows.length + ' Entries');
            $sidebar.empty();

            if (rows.length === 0) {
                $sidebar.html('<div class="text-center text-muted py-6">No schedules to display.</div>');
                return;
            }

            const frag = document.createDocumentFragment();

            rows.forEach(function (r) {
                const meta = statusMeta(r.status);
                const node = cardTpl.content.cloneNode(true);

                node.querySelector('.ws-vessel').textContent = r.vessel;

                const statusEl = node.querySelector('.ws-status');
                statusEl.textContent = r.status;
                statusEl.style.background = meta.bg;
                statusEl.style.color = meta.color;

                node.querySelector('.ws-location').textContent =
                    (r.port || '') + (r.terminal ? ' / ' + r.terminal : '');

                node.querySelector('.ws-start').textContent = fmt(r.start);
                node.querySelector('.ws-end').textContent = fmt(r.end);
                node.querySelector('.ws-tugs').textContent = r.tugCount;

                const entryEl = node.querySelector('.ws-entry');
                entryEl.addEventListener('click', function () {
                    location.href = '@Url.Action("Edit", "VesselSchedule")/' + r.id;
                });

                frag.appendChild(node);
            });

            $sidebar.append(frag);
        }

        // ---------------------------------------------------------------
        // Gantt chart
        // ---------------------------------------------------------------
        const from = '@ViewBag.From';
        const to = '@ViewBag.To';
        const ganttContainer = document.getElementById('gantt-container');

        async function loadSchedule() {
            ganttContainer.innerHTML = '<div class="text-center text-muted py-5">Loading schedule...</div>';

            const data = await fetchJson(
                '@Url.Action("GetScheduleData")?from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to)
            );

            if (!data) {
                ganttContainer.innerHTML = '<div class="text-center text-danger py-5">Failed to load schedule data.</div>';
                return;
            }

            if (!data.tasks || data.tasks.length === 0) {
                ganttContainer.innerHTML = '<div class="text-center text-muted py-5">No schedules to display on the Gantt chart.</div>';
                scheduleRows = [];
                renderSidebar();
                return;
            }

            const tasks = data.tasks.map(function (t) {
                return {
                    id: t.id,
                    name: t.name,
                    start: t.start,
                    end: t.end,
                    progress: t.progress,
                    custom_class: 'gantt-status-' + t.status.replace(/\s+/g, ''),
                    vessel: t.vessel,
                    status: t.status,
                    port: t.port,
                    terminal: t.terminal,
                    tugCount: t.tugCount,
                    notes: t.notes
                };
            });

            const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

            // Force the label text inside the bar: frappe-gantt floats it outside (class "big")
            // whenever the text is wider than the bar, which happens constantly in Day view.
            function fitBarLabels() {
                ganttContainer.querySelectorAll('.bar-wrapper').forEach(function (w) {
                    const bar = w.querySelector('.bar');
                    const label = w.querySelector('.bar-label');
                    if (!bar || !label) return;
                    const barX = parseFloat(bar.getAttribute('x'));
                    const barW = parseFloat(bar.getAttribute('width'));
                    if (!isFinite(barX) || !isFinite(barW) || barW <= 0) return;
                    if (barW < 30) { label.setAttribute('opacity', '0'); return; }
                    label.setAttribute('opacity', '1');
                    label.classList.remove('big');
                    label.setAttribute('x', barX + 3);
                    label.setAttribute('textLength', barW - 6);
                    label.setAttribute('lengthAdjust', 'spacingAndGlyphs');
                });
            }

            ganttContainer.innerHTML = '';
            const panel = document.getElementById('panel-timeline');
            new Gantt('#gantt-container', tasks, {
                view_mode: 'Day',
                date_format: 'MMM DD, HH:mm',
                bar_height: 34,
                container_height: Math.max(tasks.length * 54 + 100, panel.clientHeight - 20),
                readonly: true,     // view-only: dragging disabled
                popup_on: 'click',  // details still available via click popup
                popup: function (n) {
                    const t = n.task;
                    n.set_title(esc(t.vessel || t.name));
                    n.set_subtitle(esc(t.status) + (t.tugCount ? ' &middot; ' + t.tugCount + ' tug' + (t.tugCount > 1 ? 's' : '') : ''));
                    n.set_details(
                        fmt(t.start) + ' - ' + fmt(t.end) +
                        (t.port ? '<br/>' + esc(t.port) + (t.terminal ? ' / ' + esc(t.terminal) : '') : '') +
                        (t.notes ? '<br/><em>' + esc(t.notes) + '</em>' : '')
                    );
                }
            });
            requestAnimationFrame(function () { requestAnimationFrame(fitBarLabels); });

            scheduleRows = data.tasks;
            renderSidebar();
        }

        loadSchedule();

        // Auto-submit on date range change
        $('#schedule-filter input[type="date"]').on('change', function () {
            this.form.submit();
        });
    });
</script>
}
