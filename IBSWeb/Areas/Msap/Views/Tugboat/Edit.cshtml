@model IBS.Models.MSAP.ViewModels.TugboatViewModel

@{
    ViewData["Title"] = "Edit Tugboat";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form asp-action="Edit" method="post" id="mainForm">
        <input type="hidden" asp-for="TugboatId" />
        <main class="modern-container">
            <!-- Header Section -->
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Tugboats</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">Edit Tugboat</span>
                    </div>
                    <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">edit</span>
                            <h2 class="modern-headline-md">Tugboat Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            
                            <div class="flex flex-column gap-4">
                                <div class="modern-grid">
                                    <div class="modern-col-8">
                                        <label asp-for="TugboatName" class="modern-label">Tugboat Name <span class="text-error">*</span></label>
                                        <input asp-for="TugboatName" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Enter name" />
                                        <span asp-validation-for="TugboatName" class="text-error text-xs"></span>
                                    </div>
                                    <div class="modern-col-4">
                                        <label asp-for="TugboatNumber" class="modern-label">Tugboat # <span class="text-error">*</span></label>
                                        <input asp-for="TugboatNumber" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="3-digit code" maxlength="3" />
                                        <span asp-validation-for="TugboatNumber" class="text-error text-xs"></span>
                                    </div>
                                </div>

                                <div>
                                    <label asp-for="PortId" class="modern-label">Base Port <span class="text-error">*</span></label>
                                    <select asp-for="PortId" asp-items="@Model.PortList" class="js-modern-select" data-placeholder="-- Select Port --">
                                        <option value="">-- Select Port --</option>
                                    </select>
                                    <span asp-validation-for="PortId" class="text-error text-xs"></span>
                                </div>

                                <div class="border-t border-outline-variant pt-4">
                                    <div class="flex items-center gap-2 mb-3">
                                        <input asp-for="IsCompanyOwned" class="form-check-input" type="checkbox" id="isCompanyOwnedCheckBox" style="width:1.25rem; height:1.25rem; border: 1px solid var(--outline-variant);">
                                        <label asp-for="IsCompanyOwned" class="modern-label mb-0" style="text-transform: none; font-size: 14px; font-weight: 500;">Company Owned?</label>
                                    </div>

                                    <div id="ownerSection">
                                        <label asp-for="TugboatOwnerId" class="modern-label">Owner / Company <span class="text-error">*</span></label>
                                        <select asp-for="TugboatOwnerId" asp-items="@Model.CompanyList" class="js-modern-select" id="companyNameSelect" data-placeholder="-- Select Owner --">
                                            <option value="">-- Select Owner --</option>
                                        </select>
                                        <span asp-validation-for="TugboatOwnerId" class="text-error text-xs"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const $checkbox = $('#isCompanyOwnedCheckBox');
            const $ownerSelect = $('#companyNameSelect');
            const $ownerSection = $('#ownerSection');

            function toggleOwnerField() {
                if ($checkbox.prop("checked")) {
                    $ownerSelect.val("").trigger("change");
                    $ownerSection.fadeOut(200);
                    $ownerSelect.prop("required", false);
                } else {
                    $ownerSection.fadeIn(200);
                    $ownerSelect.prop("required", true);
                }
            }

            $checkbox.on('change', toggleOwnerField);
            toggleOwnerField();
        });
    </script>
}
