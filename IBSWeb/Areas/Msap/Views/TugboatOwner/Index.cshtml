@{
    ViewData["Title"] = "Tugboat Owners / Companies";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Tugboat Owners</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">apartment</span>
                    <h2 class="modern-headline-md">Owner List</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="tugboatOwnersTable">
                    <thead>
                        <tr>
                            <th>Owner #</th>
                            <th>Owner / Company Name</th>
                            <th>Fixed Rate</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "TugboatOwner", new { area = "User" })';
            const deleteUrl = '@Url.Action("Delete", "TugboatOwner", new { area = "User" })';

            let table = $('#tugboatOwnersTable').DataTable(ModernTable.config({
                serverSide: false,
                ajax: ModernTable.ajax("@Url.Action("GetTugboatOwnerList", "TugboatOwner", new { area = "User" })"),
                columns: [
                    { data: "tugboatOwnerNumber" },
                    { 
                        data: "tugboatOwnerName",
                        render: (data) => `<span class="font-bold uppercase">${data}</span>`
                    },
                    { 
                        data: "fixedRate",
                        render: (data) => ModernTable.render.currency(data)
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Owner', icon: 'edit', url: `${editUrl}?id=${row.tugboatOwnerId}` },
                            { 
                                label: 'Delete Owner', 
                                icon: 'delete', 
                                isError: true,
                                onclick: `confirmDelete('${deleteUrl}?id=${row.tugboatOwnerId}')`
                            }
                        ])
                    }
                ]
            }));
        });

        function confirmDelete(url) {
            ModernAlert.confirm({
                title: 'Delete Tugboat Owner?',
                text: "Are you sure you want to delete this tugboat owner entry?",
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
}
