@model Supplier

@{
    ViewData["Title"] = "Activate Supplier";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form method="post" enctype="multipart/form-data">
        <main class="modern-container">
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Suppliers</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">Activate Supplier</span>
                    </div>
                    <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary" style="background-color: var(--success);">
                        <span class="material-symbols-outlined">check_circle</span> Activate
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--success); color: white;">
                            <span class="material-symbols-outlined">person_check</span>
                            <h2 class="modern-headline-md" style="color: white;">Supplier Information</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            <input asp-for="SupplierId" hidden />

                            <div class="flex flex-column gap-3">
                                <div>
                                    <label asp-for="SupplierName" class="modern-label">Supplier Name</label>
                                    <input asp-for="SupplierName" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" disabled readonly />
                                </div>
                                <div>
                                    <label asp-for="SupplierAddress" class="modern-label">Address</label>
                                    <input asp-for="SupplierAddress" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" disabled readonly />
                                </div>
                                <div>
                                    <label asp-for="SupplierTin" class="modern-label">TIN</label>
                                    <input asp-for="SupplierTin" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" disabled readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
