@model ServiceRequestViewModel

@{
    ViewData["Title"] = "Service Request - Edit";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form id="myForm" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="DispatchTicketId" type="hidden">
        <main class="modern-container">
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label" style="color: var(--on-surface-variant)">Service Request</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">Edit @Model.DispatchNumber</span>
                    </div>
                    <h1 class="modern-headline-lg">Edit Service Request</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary" id="submitButton">
                        <span class="material-symbols-outlined">save</span> SAVE
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">arrow_back</span> BACK
                    </a>
                </div>
            </div>

            <div class="modern-grid">
                <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <!-- 0. Job Order Reference -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">assignment</span>
                            <h2 class="modern-headline-md">Job Order Reference</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            <div class="modern-grid-compact">
                                <div class="modern-col-12">
                                    <label class="modern-label">Link to Job Order <span class="text-xs" style="color: var(--on-surface-variant)">(Optional)</span></label>
                                    <select id="JobOrderId" asp-for="JobOrderId" asp-items="@Model.JobOrders" class="js-modern-select" data-placeholder="-- Select Job Order --">
                                        <option value="">-- No Job Order --</option>
                                    </select>
                                </div>
                            </div>
                            @if (Model.JobOrderId.HasValue)
                            {
                                <div id="jobOrderInfo" class="modern-grid-compact mt-2" style="background: var(--surface-container-low); padding: 0.75rem; border-radius: var(--radius-xl);">
                                    <div class="modern-col-6">
                                        <span class="modern-label text-xs">Customer</span>
                                        <p id="joCustomer" class="modern-value-sm font-bold">-</p>
                                    </div>
                                    <div class="modern-col-6">
                                        <span class="modern-label text-xs">Vessel</span>
                                        <p id="joVessel" class="modern-value-sm font-bold uppercase">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Port</span>
                                        <p id="joPort" class="modern-value-sm">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Terminal</span>
                                        <p id="joTerminal" class="modern-value-sm">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Voyage / COS</span>
                                        <p id="joVoyage" class="modern-value-sm">-</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="jobOrderInfo" class="modern-grid-compact mt-2" style="display:none; background: var(--surface-container-low); padding: 0.75rem; border-radius: var(--radius-xl);">
                                    <div class="modern-col-6">
                                        <span class="modern-label text-xs">Customer</span>
                                        <p id="joCustomer" class="modern-value-sm font-bold">-</p>
                                    </div>
                                    <div class="modern-col-6">
                                        <span class="modern-label text-xs">Vessel</span>
                                        <p id="joVessel" class="modern-value-sm font-bold uppercase">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Port</span>
                                        <p id="joPort" class="modern-value-sm">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Terminal</span>
                                        <p id="joTerminal" class="modern-value-sm">-</p>
                                    </div>
                                    <div class="modern-col-4">
                                        <span class="modern-label text-xs">Voyage / COS</span>
                                        <p id="joVoyage" class="modern-value-sm">-</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- I. Reference Information -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">info</span>
                            <h2 class="modern-headline-md">Reference Information</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="modern-grid-compact">
                                <div class="modern-col-6">
                                    <label class="modern-label">Date Today <span class="text-error">*</span></label>
                                    <input asp-for="Date" type="date" value="@(Model.Date.ToString("yyyy-MM-dd"))" class="modern-input">
                                    <span asp-validation-for="Date" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Dispatch/Mooring # <span class="text-error">*</span></label>
                                    <input asp-for="DispatchNumber" class="modern-input" placeholder="Enter Dispatch #" maxlength="20" required>
                                    <span asp-validation-for="DispatchNumber" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">COS #</label>
                                    <input asp-for="COSNumber" class="modern-input" readonly />
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Voyage #</label>
                                    <input asp-for="VoyageNumber" class="modern-input" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- II. Service Details -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">anchor</span>
                            <h2 class="modern-headline-md">Service Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="mb-2">
                                <label class="modern-label">Customer <span class="text-error">*</span></label>
                                <div id="CustomerContainer">
                                    <select id="CustomerId" asp-for="CustomerId" asp-items="@Model.Customers" class="js-modern-select" data-placeholder="-- Select Customer --">
                                        <option value="">-- Select Customer --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modern-grid-compact mb-2">
                                <div class="modern-col-6">
                                    <label class="modern-label">Port <span class="text-error">*</span></label>
                                    <select asp-for="PortId" id="PortSelect" asp-items="@Model.Ports" class="js-modern-select" data-placeholder="-- Select Port --">
                                        <option value="">-- Select Port --</option>
                                    </select>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Terminal <span class="text-error">*</span></label>
                                    <select id="TerminalSelect" asp-items="@Model.Terminals" asp-for="TerminalId" class="js-modern-select" data-placeholder="-- Select Terminal --">
                                        <option value="">-- Select Terminal --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modern-grid-compact">
                                <div class="modern-col-6">
                                    <label class="modern-label">Vessel <span class="text-error">*</span></label>
                                    <div id="VesselContainer">
                                        <select asp-for="VesselId" asp-items="@Model.Vessels" class="js-modern-select" data-placeholder="-- Select Vessel --">
                                            <option value="">-- Select Vessel --</option>
                                        </select>
                                    </div>
                                    <input type="hidden" asp-for="VoyageType" id="VoyageType" value="@Model.VoyageType" />
                                    <span id="voyageTypeBadge" class="modern-badge-sm mt-1 @(Model.VoyageType == "Foreign" ? "bg-warning text-white" : "bg-info text-white")" style="@(string.IsNullOrEmpty(Model.VoyageType) ? "display:none" : "")">@Model.VoyageType</span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Activity/Service Type <span class="text-error">*</span></label>
                                    <div id="ServiceContainer">
                                        <select asp-for="ServiceId" asp-items="@Model.Services" class="js-modern-select" data-placeholder="-- Select Service --" required>
                                            <option value="">-- Select Service --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Tugboat/Service provider <span class="text-error">*</span></label>
                                    <div id="TugboatContainer">
                                        <select asp-for="TugBoatId" asp-items="@Model.Tugboats" class="js-modern-select" data-placeholder="-- Select Tugboat --" required>
                                            <option value="">-- Select Tugboat --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Master on Duty <span class="text-error">*</span></label>
                                    <div id="TugMasterContainer">
                                        <select asp-for="TugMasterId" asp-items="@Model.TugMasters" class="js-modern-select" data-placeholder="-- Select Tug Master --" required>
                                            <option value="">-- Select Tug Master --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- III. Remarks -->
                    <div class="modern-card" style="flex: 1;">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">chat</span>
                            <h2 class="modern-headline-md">Remarks</h2>
                        </div>
                        <div class="modern-card-body" style="height: 100%;">
                            <textarea asp-for="Remarks" class="modern-input" placeholder="Enter remarks (Optional)" style="height: 100%; min-height: 120px;"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <!-- Timeline & Duration -->
                    <div class="modern-card sticky top-24">
                        <div class="modern-card-header-info" style="background-color: var(--primary); color: white;">
                            <span class="material-symbols-outlined">schedule</span>
                            <div class="flex justify-content-between w-full gap-2">
                                <h2 class="modern-headline-md" style="color: white">Timeline</h2>
                                <span id="durationBadge" class="modern-badge" style="background: white; color: var(--primary);">0.00 hrs</span>
                            </div>
                        </div>
                        <div class="modern-card-body">
                            <div class="mb-2">
                                <label class="modern-label font-bold">Start Date & Time <span class="text-error">*</span></label>
                                <div class="flex gap-2 mt-1">
                                    <input type="date" asp-for="DateLeft" id="DateLeft" value="@(Model.DateLeft?.ToString("yyyy-MM-dd"))" class="modern-input timeline-input" required>
                                    <input type="time" asp-for="TimeLeft" id="TimeLeft" value="@(Model.TimeLeft?.ToString("HH\\:mm"))" class="modern-input timeline-input" required>
                                </div>
                            </div>
                            <div>
                                <label class="modern-label font-bold">End Date & Time <span class="text-error">*</span></label>
                                <div class="flex gap-2 mt-1">
                                    <input type="date" asp-for="DateArrived" id="DateArrived" value="@(Model.DateArrived?.ToString("yyyy-MM-dd"))" class="modern-input timeline-input" required>
                                    <input type="time" asp-for="TimeArrived" id="TimeArrived" value="@(Model.TimeArrived?.ToString("HH\\:mm"))" class="modern-input timeline-input" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Media Uploads -->
                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">camera</span>
                            <h2 class="modern-headline-md">Media Attachments</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="mb-4">
                                <div class="flex justify-between items-center mb-1">
                                    <label class="modern-label">Dispatch Ticket Image <span class="text-error">*</span></label>
                                    <div class="flex gap-1">
                                        @if (!string.IsNullOrEmpty(Model.ImageName))
                                        {
                                            <button type="button" id="viewImageBtn" class="modern-btn-text text-xs">
                                                <span class="material-symbols-outlined text-sm">visibility</span> VIEW
                                            </button>
                                            <button type="button" id="deleteImageBtn" class="modern-btn-text text-xs" style="color: var(--error);">
                                                <span class="material-symbols-outlined text-sm">delete</span> DELETE
                                            </button>
                                        }
                                        <button type="button" id="btnPreviewImage" class="modern-btn-text text-xs" style="display:none;">
                                            <span class="material-symbols-outlined text-sm">visibility</span> PREVIEW
                                        </button>
                                    </div>
                                </div>
                                <input class="modern-input" id="imageUpload" name="imageFile" type="file" accept="image/*" style="padding: 0.35rem;">
                                @if (string.IsNullOrEmpty(Model.ImageName))
                                {
                                    <span class="text-error text-xs">An image of the Dispatch/Mooring Ticket is required.</span>
                                }
                            </div>
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <label class="modern-label">Operation Video</label>
                                    <div class="flex gap-1">
                                        @if (!string.IsNullOrEmpty(Model.VideoName))
                                        {
                                            <button type="button" id="viewVideoBtn" class="modern-btn-text text-xs">
                                                <span class="material-symbols-outlined text-sm">visibility</span> VIEW
                                            </button>
                                            <button type="button" id="deleteVideoBtn" class="modern-btn-text text-xs" style="color: var(--error);">
                                                <span class="material-symbols-outlined text-sm">delete</span> DELETE
                                            </button>
                                        }
                                        <button type="button" id="btnPreviewVideo" class="modern-btn-text text-xs" style="display:none;">
                                            <span class="material-symbols-outlined text-sm">visibility</span> PREVIEW
                                        </button>
                                    </div>
                                </div>
                                <input class="modern-input" id="videoUpload" name="videoFile" type="file" accept="video/*" style="padding: 0.35rem;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function disableTrigger(id) {
                $(id).next('.modern-select-container').find('.modern-select-trigger')
                    .css('pointer-events', 'none').addClass('disabled');
            }
            // Lock JO-derived fields on load
            disableTrigger('#CustomerId');
            disableTrigger('#VesselId');
            disableTrigger('#PortSelect');
            disableTrigger('#TerminalSelect');
            $('#COSNumber').prop('readonly', true);
            $('#VoyageNumber').prop('readonly', true);

            // --- Vessel → VoyageType auto-set ---
            function updateVoyageType() {
                const vesselId = $('#VesselId').val();
                if (!vesselId) { $('#voyageTypeBadge').hide(); return; }
                $.get('@Url.Action("GetVesselVoyageType", "ServiceRequest")', { vesselId: vesselId })
                    .done(function (data) {
                        $('#VoyageType').val(data);
                        const $badge = $('#voyageTypeBadge');
                        $badge.text(data).show();
                        $badge.removeClass('bg-warning text-white bg-info text-white')
                              .addClass(data === 'Foreign' ? 'bg-warning text-white' : 'bg-info text-white');
                    });
            }
            $('#VesselId').on('change', updateVoyageType);
            if ($('#VesselId').val()) { updateVoyageType(); }

            // --- Port/Terminal Cascading Dropdown ---
            $('#PortSelect').on('change', function () {
                const portId = $(this).val();
                if (!portId) return;

                $('#terminalLoading').show();
                $.get('@Url.Action("ChangeTerminal", "ServiceRequest")', { portId: portId }, function (data) {
                    const $select = $('#TerminalSelect');
                    $select.empty().append('<option value="">-- Select Terminal --</option>');
                    $.each(data, function (i, item) {
                        $select.append($('<option>', { value: item.value, text: item.text }));
                    });
                    if (typeof refreshModernSelect === 'function') {
                        refreshModernSelect($select);
                    }
                }).always(() => $('#terminalLoading').hide());
            });

            // --- Duration Calculation ---
            function calculateDuration() {
                const startD = $('#DateLeft').val();
                const startT = $('#TimeLeft').val();
                const endD = $('#DateArrived').val();
                const endT = $('#TimeArrived').val();

                if (startD && startT && endD && endT) {
                    const start = new Date(`${startD}T${startT}`);
                    const end = new Date(`${endD}T${endT}`);
                    if (!isNaN(start) && !isNaN(end)) {
                        const diff = (end - start) / 3600000;
                        const $badge = $('#durationBadge');
                        if (diff < 0) {
                            $badge.text("Invalid").css({'background': 'var(--error)', 'color': 'white'});
                        } else {
                            $badge.text(diff.toFixed(2) + " hrs").css({'background': 'white', 'color': 'var(--primary)'});
                        }
                    }
                }
            }
            $('.timeline-input').on('change input', calculateDuration);
            calculateDuration();

            // --- Media Preview (new files) ---
            let imageBlobUrl = null;
            let videoBlobUrl = null;

            $('#imageUpload').on('change', function() {
                const file = this.files[0];
                if (file) {
                    if (imageBlobUrl) URL.revokeObjectURL(imageBlobUrl);
                    imageBlobUrl = URL.createObjectURL(file);
                    $('#btnPreviewImage').show();
                } else {
                    $('#btnPreviewImage').hide();
                }
            });

            $('#videoUpload').on('change', function() {
                const file = this.files[0];
                if (file) {
                    if (videoBlobUrl) URL.revokeObjectURL(videoBlobUrl);
                    videoBlobUrl = URL.createObjectURL(file);
                    $('#btnPreviewVideo').show();
                } else {
                    $('#btnPreviewVideo').hide();
                }
            });

            $('#btnPreviewImage').on('click', function() {
                if (imageBlobUrl) {
                    ModernAlert.image(imageBlobUrl, "Dispatch Ticket Image Preview");
                }
            });

            $('#btnPreviewVideo').on('click', function() {
                if (videoBlobUrl) {
                    ModernAlert.video(videoBlobUrl, "Operation Video Preview");
                }
            });

            // --- View / Delete existing media ---
            $('#viewImageBtn').on('click', function() {
                ModernAlert.image('@Html.Raw(Model.ImageSignedUrl)', "Service Request Image");
            });

            $('#deleteImageBtn').on('click', function() {
                ModernAlert.confirm({ title: "Delete image?", icon: 'warning' }).then((r) => {
                    if (r.isConfirmed) {
                        const token = $('input[name="__RequestVerificationToken"]').val();
                        $.post('@Url.Action("DeleteImage", "ServiceRequest")', { id: @Model.DispatchTicketId, __RequestVerificationToken: token })
                            .done(() => { window.location.href = '@Url.Action("Edit", "ServiceRequest", new { id = Model.DispatchTicketId })'; })
                            .fail(() => { window.location.href = '@Url.Action("Edit", "ServiceRequest", new { id = Model.DispatchTicketId })'; });
                    }
                });
            });

            $('#viewVideoBtn').on('click', function() {
                ModernAlert.video('@Html.Raw(Model.VideoSignedUrl)', "Service Request Video");
            });

            $('#deleteVideoBtn').on('click', function() {
                ModernAlert.confirm({ title: "Delete video?", icon: 'warning' }).then((r) => {
                    if (r.isConfirmed) {
                        const token = $('input[name="__RequestVerificationToken"]').val();
                        $.post('@Url.Action("DeleteVideo", "ServiceRequest")', { id: @Model.DispatchTicketId, __RequestVerificationToken: token })
                            .done(() => { window.location.href = '@Url.Action("Edit", "ServiceRequest", new { id = Model.DispatchTicketId })'; })
                            .fail(() => { window.location.href = '@Url.Action("Edit", "ServiceRequest", new { id = Model.DispatchTicketId })'; });
                    }
                });
            });
        });
    </script>
}
