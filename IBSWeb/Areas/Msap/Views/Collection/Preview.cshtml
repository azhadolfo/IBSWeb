@model Collection

@{
    ViewData["Title"] = "Collection Details";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <a class="modern-label" style="text-decoration:none;" asp-action="Index">Collections</a>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">@Model.MsapCollectionNumber</span>
                </div>
                <h1 class="modern-headline-lg">@Model.MsapCollectionNumber</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MsapCollectionId" class="modern-btn-primary">
                    <span class="material-symbols-outlined">edit</span> EDIT COLLECTION
                </a>
                <a asp-action="Index" class="modern-btn-secondary">
                    <span class="material-symbols-outlined">arrow_back</span> BACK TO LIST
                </a>
            </div>
        </div>

        <div class="modern-grid">
            <!-- Left Column: Payer & Paid Items (col-8) -->
            <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                <!-- Customer Details -->
                <div class="modern-card">
                    <div class="modern-card-header-info">
                        <span class="material-symbols-outlined">person</span>
                        <h2 class="modern-headline-md">Customer Information</h2>
                    </div>
                    <div class="modern-card-body">
                        <div class="modern-grid-compact">
                            <div class="modern-col-6">
                                <p class="modern-label">Customer Name</p>
                                <p class="modern-value-md font-bold">@Model.Customer?.CustomerName</p>
                            </div>
                            <div class="modern-col-6">
                                <p class="modern-label">TIN</p>
                                <p class="modern-value-md">@Model.Customer?.CustomerTin</p>
                            </div>
                        </div>
                        <div class="mt-3">
                            <p class="modern-label">Address</p>
                            <p class="modern-value-md">@Model.Customer?.CustomerAddress</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Customer?.BusinessStyle))
                        {
                            <div class="mt-3">
                                <p class="modern-label">Business Style</p>
                                <p class="modern-value-md">@Model.Customer.BusinessStyle</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Settled Billings -->
                <div class="modern-card">
                    <div class="modern-card-header-info">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <h2 class="modern-headline-md">Paid Billings</h2>
                    </div>
                    <div class="modern-card-body">
                        <div class="modern-table-container border border-outline-variant">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>BILLING #</th>
                                        <th class="text-center">DATE</th>
                                        <th class="text-right">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.PaidBills != null && Model.PaidBills.Any())
                                    {
                                        @foreach (var billing in Model.PaidBills)
                                        {
                                            <tr>
                                                <td class="font-bold">
                                                    <a href="@Url.Action("Preview", "Billing", new { id = billing.MsapBillingId })" style="text-decoration:none; color: var(--primary)">
                                                        @billing.MsapBillingNumber
                                                    </a>
                                                </td>
                                                <td class="text-center">@billing.CreatedDate.ToString(SD.Date_Format)</td>
                                                <td class="text-right font-bold">₱@billing.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-4 opacity-60 italic">No billings settled in this collection.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Collection Metadata & Totals (col-4) -->
            <div class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                <!-- Totals -->
                <div class="modern-card">
                    <div class="modern-card-header-info" style="background-color: var(--primary); color: white;">
                        <span class="material-symbols-outlined">payments</span>
                        <h2 class="modern-headline-md">Collection Totals</h2>
                    </div>
                    <div class="modern-card-body">
                        <div class="financial-summary-card" style="flex-direction: column; gap: 0.75rem;">
                            <div class="financial-item">
                                <span class="financial-label">Net Collected</span>
                                <span class="financial-value primary">₱@Model.Amount.ToString("N2")</span>
                            </div>
                            <div class="financial-divider" style="width: 100%; height: 1px;"></div>
                            <div class="financial-item">
                                <span class="financial-label">EWT Amount</span>
                                <span class="financial-value" style="color: var(--error)">₱@Model.EWT.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reference Details -->
                <div class="modern-card">
                    <div class="modern-card-header-info">
                        <span class="material-symbols-outlined">description</span>
                        <h2 class="modern-headline-md">Collection Metadata</h2>
                    </div>
                    <div class="modern-card-body">
                        <div class="flex flex-column" style="gap: 1rem;">
                            <div>
                                <p class="modern-label">Collection Date</p>
                                <p class="modern-value-md font-bold">@Model.Date.ToString(SD.Date_Format)</p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ReferenceNo))
                            {
                                <div>
                                    <p class="modern-label">Reference #</p>
                                    <p class="modern-value-md">@Model.ReferenceNo</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Remarks))
                            {
                                <div class="border-t border-outline-variant pt-3">
                                    <p class="modern-label">Remarks</p>
                                    <p class="text-xs opacity-80 italic">@Model.Remarks</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Bank & Check -->
                <div class="modern-card">
                    <div class="modern-card-header-info">
                        <span class="material-symbols-outlined">account_balance</span>
                        <h2 class="modern-headline-md">Deposit Information</h2>
                    </div>
                    <div class="modern-card-body">
                        <div class="flex flex-column" style="gap: 1rem;">
                            <div>
                                <p class="modern-label">Bank Account</p>
                                <p class="modern-value-md font-bold">@Model.BankAccount?.Bank</p>
                                <p class="text-xs opacity-60">@Model.BankAccount?.AccountNo - @Model.BankAccount?.AccountName</p>
                            </div>
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label">Check Details</p>
                                <p class="modern-value-md">#@Model.CheckNumber</p>
                                <p class="text-xs">Date: @(Model.CheckDate.HasValue ? Model.CheckDate.Value.ToString(SD.Date_Format) : "--")</p>
                            </div>
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label">Deposit Date</p>
                                <p class="modern-value-md">@(Model.DepositDate.HasValue ? Model.DepositDate.Value.ToString(SD.Date_Format) : "--")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
