@{
    ViewData["Title"] = "Activities / Services";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Activities / Services</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">list_alt</span>
                    <h2 class="modern-headline-md">Service List</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="servicesTable">
                    <thead>
                        <tr>
                            <th>Service #</th>
                            <th>Service Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "MaritimeService", new { area = "User" })';
            const deleteUrl = '@Url.Action("Delete", "MaritimeService", new { area = "User" })';

            let table = $('#servicesTable').DataTable(ModernTable.config({
                serverSide: false, // Use client-side for simple master files
                ajax: ModernTable.ajax("@Url.Action("GetMaritimeServiceList", "MaritimeService", new { area = "User" })"),
                columns: [
                    { data: "serviceNumber" },
                    { 
                        data: "serviceName",
                        render: (data) => `<span class="font-bold">${data}</span>`
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Service', icon: 'edit', url: `${editUrl}?id=${row.serviceId}` },
                            { 
                                label: 'Delete Service', 
                                icon: 'delete', 
                                isError: true,
                                onclick: `confirmDelete('${deleteUrl}?id=${row.serviceId}')`
                            }
                        ])
                    }
                ]
            }));
        });

        function confirmDelete(url) {
            ModernAlert.confirm({
                title: 'Delete Service?',
                text: "Are you sure you want to delete this activity/service entry?",
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
}
