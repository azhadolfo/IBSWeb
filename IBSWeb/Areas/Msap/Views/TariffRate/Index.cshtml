@{
    ViewData["Title"] = "Tariff Rates";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Tariff Rates</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">payments</span>
                    <h2 class="modern-headline-md">Tariff Rate List</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="tariffRatesTable">
                    <thead>
                        <tr>
                            <th>As of Date</th>
                            <th>Customer</th>
                            <th>Port / Terminal</th>
                            <th>Service</th>
                            <th>Dispatch</th>
                            <th>BAF</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "TariffRate", new { area = "User" })';
            const deleteUrl = '@Url.Action("Delete", "TariffRate", new { area = "User" })';

            let table = $('#tariffRatesTable').DataTable(ModernTable.config({
                serverSide: false,
                ajax: ModernTable.ajax("@Url.Action("GetTariffRateList", "TariffRate", new { area = "User" })"),
                columns: [
                    { 
                        data: "asOfDate",
                        render: (data) => ModernTable.render.date(data)
                    },
                    { 
                        data: "customer.customerName",
                        render: (data) => ModernTable.render.ellipsis(data, 200)
                    },
                    { 
                        data: "terminal.terminalName",
                        render: (data, type, row) => `<div>${row.port.portName}</div><div class="text-xs text-muted">${data}</div>`
                    },
                    { data: "service.serviceName" },
                    { 
                        data: "dispatch",
                        render: (data) => ModernTable.render.currency(data)
                    },
                    { 
                        data: "baf",
                        render: (data) => ModernTable.render.currency(data)
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Tariff', icon: 'edit', url: `${editUrl}?id=${row.tariffRateId}` },
                            { 
                                label: 'Delete Tariff', 
                                icon: 'delete', 
                                isError: true,
                                onclick: `confirmDelete('${deleteUrl}?id=${row.tariffRateId}')`
                            }
                        ])
                    }
                ]
            }));
        });

        function confirmDelete(url) {
            ModernAlert.confirm({
                title: 'Delete Tariff Rate?',
                text: "Are you sure you want to delete this tariff rate entry?",
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
}
