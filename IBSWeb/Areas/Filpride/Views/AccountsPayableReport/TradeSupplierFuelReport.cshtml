@model ViewModelBook

@{
    ViewData["Title"] = "Accounts Payable Report - Trade Supplier Fuel Report";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@ViewData["Title"]</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form id="dynamicForm" method="post" target="_blank">
            <div class="row">

                <div class="mb-4 row align-items-center">
                    <label for="monthDate" class="col-sm-4 col-form-label text-end fw-semibold">
                        As Of (Month and Year)
                    </label>
                    <div class="col-sm-6">
                        <input type="month"
                               id="monthDate"
                               name="monthDate"
                               class="form-control"
                               value="@DateTimeHelper.GetCurrentPhilippineTime().ToString("yyyy-MM")"
                               required />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label asp-for="StatusFilter"
                           class="col-sm-4 col-form-label text-end fw-semibold">
                    </label>
                    <div class="col-sm-6">
                        <select asp-for="StatusFilter" class="form-select">
                            <option value="ValidOnly">Valid Only</option>
                            <option value="All">All (Include Voided)</option>
                            <option value="InvalidOnly">Voided Only</option>
                        </select>
                        <span asp-validation-for="StatusFilter" class="text-danger"></span>
                    </div>
                </div>

                <div class="row pt-2">
                    <div class="offset-sm-4 col-sm-6">
                        <button type="button"
                                class="btn btn-primary w-100"
                                onclick="submitForm('GenerateTradeSupplierFuelReportExcelFile')">
                            <i class="bi bi-file-text"></i>
                            Generate as Excel file
                        </button>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function submitForm(action) {
            var form = document.getElementById('dynamicForm');
            form.action = action;
            form.submit();
        }
    </script>
}

