@model List<IBS.Models.Filpride.MasterFile.FilprideCollectionCategory>
@{
    ViewData["Title"] = "Collection Categories";
}

<link rel="stylesheet" href="~/css/index-style.css">

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 bg-secondary p-3 rounded shadow">
        <h2 class="text-white m-0">@ViewData["Title"]</h2>
        <a asp-action="Edit" class="btn btn-light">
            <i class="bi bi-plus-circle"></i> Create New Category
        </a>
    </div>
    <div class="card shadow border-0 mt-3">
        <div class="card-body p-3">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">Add an active collection category before creating provisional receipts.</div>
            }
            <div class="table-responsive" style="max-height: 70vh">
                <table class="table table-hover mb-0" id="paginatedTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Name</th>
                            <th>Tagging</th>
                            <th>Allowed Types</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var category in Model)
                    {
                        var types = new List<string>();
                        if (category.AllowCompany) types.Add("Company");
                        if (category.AllowEmployee) types.Add("Employee");
                        if (category.AllowBankAccount) types.Add("Bank Account");
                        <tr>
                            <td>@category.Name</td>
                            <td>@category.TaggingRequirement</td>
                            <td>@(types.Count == 0 ? "None" : string.Join(", ", types))</td>
                            <td>@(category.IsActive ? "Active" : "Inactive")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-primary">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#paginatedTable').DataTable({
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, searchable: false, targets: 4 }],
                language: { emptyTable: 'No collection categories available.' }
            });
        });
    </script>
}
