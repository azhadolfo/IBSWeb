@using IBS.Models.Enums
@{
    ViewData["Title"] = "Provisional Receipt";
}

<link rel="stylesheet" href="~/css/index-style.css">

<div class="container-fluid mt-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center bg-secondary p-3 rounded shadow">
        <h2 class="text-white m-0">@ViewData["Title"]</h2>
        <a asp-area="Filpride" asp-controller="ProvisionalReceipt" asp-action="Create" class="btn btn-light">
            <i class="bi bi-plus-circle"></i> New Receipt
        </a>
    </div>

    <div class="card shadow border-0 mt-3">
        <div class="card-body p-3">
            <div class="me-2">
                <label class="fw-semibold small text-muted mb-1">Filter by Date</label>
                <input type="date" id="inputDate" class="form-control rounded-3 shadow-sm" style="width:150px;">
            </div>
            <div class="table-responsive" style="max-height: 70vh">
                <table class="table table-hover mb-0" id="paginatedTable">
                    <thead class="bg-light">
                    <tr>
                        <th>PR#</th>
                        <th>Date</th>
                        <th>Deposited Date</th>
                        <th>Cleared Date</th>
                        <th>Received From</th>
                        <th>Collection Category</th>
                        <th>Reference#</th>
                        <th>Total</th>
                        <th>Created By</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function addDepositInfo(provisionalReceiptId) {
            const response = await fetch('@Url.Action("GetBanks", "ProvisionalReceipt", new { area = "Filpride" })');
            const banks = await response.json();
            let bankOptions = '<option value="">Select a bank</option>' + banks.map(b => `<option value="${b.value}">${b.text}</option>`).join('');
            let bankSelect = `<select id="swal-input2" class="swal2-select w-75" style="width: 75%;">${bankOptions}</select>`;
            let minDate = new Date('@(ViewBag.MinDate?.ToString("yyyy-MM-dd") ?? "1900-01-01")').toISOString().split('T')[0];
            let today = new Date().toISOString().split('T')[0];

            Swal.fire({
                title: 'Enter Deposit Info',
                html: `<input id="swal-input1" type="date" value="${today}" min="${minDate}" class="swal2-input w-75">` + bankSelect,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Next',
                didOpen: () => {
                    $('#swal-input2').select2({ dropdownParent: $('.swal2-container') });
                },
                preConfirm: () => {
                    const depositDate = document.getElementById('swal-input1').value;
                    const bankId = $('#swal-input2').val();
                    let selectedDate = new Date(depositDate);
                    let minDateObj = new Date(minDate);

                    if (!depositDate || !bankId) {
                        Swal.showValidationMessage('Both Deposit Date and Bank are required');
                        return false;
                    }

                    if (selectedDate < minDateObj) {
                        Swal.showValidationMessage(`The selected date cannot be before ${minDateObj.toLocaleDateString()}.`);
                        return false;
                    }

                    return { depositDate, bankId };
                },
                willClose: () => {
                    if ($('#swal-input2').data('select2')) {
                        $('#swal-input2').select2('destroy');
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const { depositDate, bankId } = result.value;
                    const bankName = banks.find(b => b.value == bankId)?.text || "Unknown Bank";

                    Swal.fire({
                        title: 'Confirm Deposit',
                        html: `<p><b>Deposit Date:</b> ${depositDate}</p><p><b>Bank:</b> ${bankName}</p>`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Confirm'
                    }).then((confirmResult) => {
                        if (confirmResult.isConfirmed) {
                            window.location.href = `@Url.Action("Deposit", "ProvisionalReceipt", new { area = "Filpride" })/${provisionalReceiptId}?depositDate=${encodeURIComponent(depositDate)}&bankId=${encodeURIComponent(bankId)}`;
                        }
                    });
                }
            });
        }

        async function redeposit(provisionalReceiptId, bankId) {
            const response = await fetch('@Url.Action("GetBanks", "ProvisionalReceipt", new { area = "Filpride" })');
            const banks = await response.json();
            let bankOptions = '<option value="">Select a bank</option>' + banks.map(b => `<option value="${b.value}" ${b.value == bankId ? "selected" : ""}>${b.text}</option>`).join('');
            let bankSelect = `<select id="swal-input2" class="swal2-select w-75" style="width: 75%;">${bankOptions}</select>`;
            let minDate = new Date('@(ViewBag.MinDate?.ToString("yyyy-MM-dd") ?? "1900-01-01")').toISOString().split('T')[0];
            let today = new Date().toISOString().split('T')[0];

            Swal.fire({
                title: 'Enter Deposit Date',
                html: `<input id="swal-input1" type="date" value="${today}" min="${minDate}" class="swal2-input w-75">` + bankSelect,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Next',
                didOpen: () => {
                    $('#swal-input2').select2({
                        dropdownParent: $('.swal2-container'),
                        width: '75%',
                        placeholder: 'Select a bank'
                    });
                },
                preConfirm: () => {
                    const depositDate = document.getElementById('swal-input1').value;
                    const selectedBankId = $('#swal-input2').val();
                    let selectedDate = new Date(depositDate);
                    let minDateObj = new Date(minDate);

                    if (!depositDate) {
                        Swal.showValidationMessage('Deposit Date is required');
                        return false;
                    }

                    if (!selectedBankId) {
                        Swal.showValidationMessage('Bank is required');
                        return false;
                    }

                    if (selectedDate < minDateObj) {
                        Swal.showValidationMessage(`The selected date cannot be before ${minDateObj.toLocaleDateString()}.`);
                        return false;
                    }

                    return { depositDate, bankId: selectedBankId };
                },
                willClose: () => {
                    if ($('#swal-input2').data('select2')) {
                        $('#swal-input2').select2('destroy');
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const { depositDate, bankId } = result.value;
                    const bankName = banks.find(b => b.value == bankId)?.text || "Unknown Bank";

                    Swal.fire({
                        title: 'Confirm Redeposit',
                        html: `<p><b>Deposit Date:</b> ${depositDate}</p><p><b>Bank:</b> ${bankName}</p>`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Confirm'
                    }).then((confirmResult) => {
                        if (confirmResult.isConfirmed) {
                            window.location.href = `@Url.Action("Redeposit", "ProvisionalReceipt", new { area = "Filpride" })/${provisionalReceiptId}?redepositDate=${encodeURIComponent(depositDate)}&bankId=${encodeURIComponent(bankId)}`;
                        }
                    });
                }
            });
        }

        function returnCheck(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `@Url.Action("Return", "ProvisionalReceipt", new { area = "Filpride" })/${id}`;
                }
            });
        }

        async function applyClearingDate(provisionalReceiptId) {
            let minDate = new Date('@(ViewBag.MinDate?.ToString("yyyy-MM-dd") ?? "1900-01-01")').toISOString().split('T')[0];
            let today = new Date().toISOString().split('T')[0];

            Swal.fire({
                title: 'Enter Clearing Date',
                html: `<input id="swal-input1" type="date" value="${today}" min="${minDate}" class="swal2-input w-75">`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Next',
                preConfirm: () => {
                    const clearingDate = document.getElementById('swal-input1').value;
                    let selectedDate = new Date(clearingDate);
                    let minDateObj = new Date(minDate);

                    if (!clearingDate) {
                        Swal.showValidationMessage('Clearing Date is required');
                        return false;
                    }

                    if (selectedDate < minDateObj) {
                        Swal.showValidationMessage(`The selected date cannot be before ${minDateObj.toLocaleDateString()}.`);
                        return false;
                    }

                    return clearingDate;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    let clearingDate = result.value;

                    Swal.fire({
                        title: 'Apply Clearing Date',
                        html: `<p><b>Cleared Date:</b> ${clearingDate}</p>`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Confirm'
                    }).then((confirmResult) => {
                        if (confirmResult.isConfirmed) {
                            window.location.href = `@Url.Action("ApplyClearingDate", "ProvisionalReceipt", new { area = "Filpride" })/${provisionalReceiptId}?clearingDate=${encodeURIComponent(clearingDate)}`;
                        }
                    });
                }
            });
        }

        function confirmVoid(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Void", "ProvisionalReceipt", new { area = "Filpride" })',
                        type: 'POST',
                        data: { id: id },
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: response.message,
                                    showConfirmButton: false,
                                    timer: 2000
                                }).then(function() {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Something went wrong.', 'error');
                        }
                    });
                }
            });
        }

        function confirmCancel(id) {
            Swal.fire({
                title: "Please Input Remarks",
                html: "<input id='cancellationRemarks' type='text' class='swal2-input' placeholder='Remarks'>",
                focusConfirm: false,
                allowEscapeKey: false,
                allowOutsideClick: false,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Cancel", "ProvisionalReceipt", new { area = "Filpride" })',
                        type: 'POST',
                        data: {
                            id: id,
                            cancellationRemarks: $("#cancellationRemarks").val()
                        },
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: response.message,
                                    showConfirmButton: false,
                                    timer: 2000
                                }).then(function() {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Something went wrong.', 'error');
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            const pendingStatus = "@nameof(CollectionReceiptStatus.Pending)";
            const postedStatus = "@nameof(CollectionReceiptStatus.Posted)";
            const depositedStatus = "@nameof(CollectionReceiptStatus.Deposited)";
            const redepositedStatus = "@nameof(CollectionReceiptStatus.Redeposited)";
            const returnedStatus = "@nameof(CollectionReceiptStatus.Returned)";
            const activePostedStatuses = [postedStatus, depositedStatus, returnedStatus, redepositedStatus, "@nameof(CollectionReceiptStatus.Cleared)"];
            let filterValue = localStorage.getItem('provisionalReceiptFilterDate') || "";
            $('#inputDate').val(filterValue);

            let table = $('#paginatedTable').DataTable({
                processing: true,
                serverSide: true,
                stateSave: true,
                stateDuration: 86400,
                language: {
                    processing: `<div class="d-flex justify-content-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                 </div>`
                },
                ajax: {
                    url: "@Url.Action("GetProvisionalReceipts", "ProvisionalReceipt", new { area = "Filpride" })",
                    type: "POST",
                    data: function (d) {
                        return $.extend({}, d, {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                            filterDate: filterValue
                        });
                    },
                    error: function (xhr, error, thrown) {
                        console.error('DataTables error:', error);
                        alert('An error occurred while loading the data');
                    }
                },
                preDrawCallback: function() {
                    $('#paginatedTable').addClass('table-loading');
                },
                drawCallback: function() {
                    $('#paginatedTable').removeClass('table-loading');
                    $('[data-bs-toggle="tooltip"]').tooltip();
                },
                columns: [
                    { data: "seriesNumber", name: "seriesNumber" },
                    {
                        data: "transactionDate",
                        name: "transactionDate",
                        render: formatDate
                    },
                    {
                        data: "depositedDate",
                        name: "depositedDate",
                        render: formatDate
                    },
                    {
                        data: "clearedDate",
                        name: "clearedDate",
                        render: formatDate
                    },
                    { data: "payerName", name: "payerName", render: $.fn.dataTable.render.text() },
                    { data: "categoryName", name: "categoryName", render: $.fn.dataTable.render.text() },
                    { data: "referenceNo", name: "referenceNo", render: $.fn.dataTable.render.text() },
                    {
                        data: "total",
                        name: "total",
                        render: function (data) {
                            return $.fn.dataTable.render.number(',', '.', 2).display(data);
                        }
                    },
                    { data: "createdBy", name: "createdBy", render: $.fn.dataTable.render.text() },
                    {
                        data: "status",
                        name: "status",
                        render: function(data, type, row) {
                            var statusClass = row.status === postedStatus
                                || row.status === depositedStatus
                                || row.status === redepositedStatus
                                ? "bg-info"
                                : row.status === "@nameof(CollectionReceiptStatus.Cleared)"
                                    ? "bg-success"
                                    : row.status === "@nameof(CollectionReceiptStatus.Voided)"
                                    || row.status === returnedStatus
                                        ? "bg-danger"
                                        : row.status === "@nameof(CollectionReceiptStatus.Canceled)"
                                            ? "bg-warning"
                                            : "";

                            return `<span class="badge rounded-pill ${statusClass}">${row.status}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let dropdownHtml = `
                                <div class="dropdown actions-dropdown" style="${row.voidedBy != null || row.canceledBy != null ? 'display:none;' : ''}">
                                    <button class="btn btn-light btn-sm dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">`;
                            const canEdit = row.status === pendingStatus && row.postedBy == null && row.canceledBy == null && row.voidedBy == null;
                            const canManagePosted = activePostedStatuses.includes(row.status) && row.postedBy != null && row.canceledBy == null && row.voidedBy == null;

                            if (canEdit) {
                                dropdownHtml += `<li><a href="@Url.Action("Edit", "ProvisionalReceipt", new { area = "Filpride" })/${row.id}" class="dropdown-item">Edit</a></li>`;
                                dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="confirmCancel(${row.id})">Cancel</a></li>`;
                                dropdownHtml += `<li><a href="@Url.Action("Print", "ProvisionalReceipt", new { area = "Filpride" })/${row.id}" class="dropdown-item">Preview</a></li>`;
                            } else if (canManagePosted) {
                                if (row.status === postedStatus) {
                                    dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="addDepositInfo(${row.id})">Add Deposit Info</a></li>`;
                                }

                                if (row.status === depositedStatus || row.status === redepositedStatus) {
                                    dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="applyClearingDate(${row.id})">Apply Clearing Date</a></li>`;
                                    dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="returnCheck(${row.id})">Return Check</a></li>`;
                                }

                                if (row.status === returnedStatus) {
                                    dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="redeposit(${row.id}, ${row.bankId})">Redeposit</a></li>`;
                                }

                                dropdownHtml += `<li><a href="@Url.Action("Print", "ProvisionalReceipt", new { area = "Filpride" })/${row.id}" class="dropdown-item">Preview</a></li>`;
                                dropdownHtml += `<li><a class="dropdown-item" href="javascript:void(0);" onclick="confirmVoid(${row.id})">Void</a></li>`;
                            } else {
                                dropdownHtml += `<li><a href="@Url.Action("Print", "ProvisionalReceipt", new { area = "Filpride" })/${row.id}" class="dropdown-item">Preview</a></li>`;
                            }

                            dropdownHtml += `</ul></div>`;
                            return dropdownHtml;
                        }
                    }
                ]
            });

            $('#inputDate').on('change', function() {
                filterValue = $(this).val();
                localStorage.setItem('provisionalReceiptFilterDate', filterValue);
                table.ajax.reload();
            });

            function formatDate(data) {
                if (!data) {
                    return '';
                }

                return new Date(data).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: '2-digit'
                });
            }
        });
    </script>
}
