@model SubsidiaryLedgerReportViewModel

@{
    ViewData["Title"] = "Subsidiary Ledger Report";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@ViewData["Title"]</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form id="dynamicForm" method="post" target="_blank">
            <div class="row">
                <!-- As Of Month -->
                <div class="mb-4 row align-items-center">
                    <label for="MonthDate" class="col-sm-4 col-form-label text-end fw-semibold">
                        As Of (Month and Year)
                    </label>

                    <div class="col-sm-6">
                        <input type="month"
                               asp-for="MonthDate"
                               class="form-control"
                               value="@DateTimeHelper.GetCurrentPhilippineTime().ToString("yyyy-MM")"
                               required />
                    </div>
                </div>

                <!-- Account List -->
                <div class="mb-4 row align-items-center">
                    <label asp-for="AccountNo" class="col-sm-4 col-form-label text-end fw-semibold">
                        Account List
                    </label>

                    <div class="col-sm-6">
                        <select asp-for="AccountNo"
                                asp-items="@Model.ChartOfAccounts"
                                class="form-select js-select2"
                                style="width: 100%;"
                                required >
                            <option value="">Select account</option>
                        </select>

                        <span asp-validation-for="AccountNo" class="text-danger"></span>
                    </div>
                </div>

                <!-- Generate Button -->
                <div class="row pt-2">
                    <div class="offset-sm-4 col-sm-6">
                        <button type="button"
                                class="btn btn-primary w-100"
                                onclick="submitForm('GenerateSubsidiaryLedgerExcelFile')">
                            <i class="bi bi-file-earmark-excel me-1"></i>
                            Generate as Excel File
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function submitForm(action) {
            var form = document.getElementById('dynamicForm');
            form.action = action;
            form.submit();
        }
    </script>
}
