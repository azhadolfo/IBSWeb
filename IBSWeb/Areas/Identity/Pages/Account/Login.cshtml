@page
@using IBS.Utility
@using Microsoft.Extensions.Options
@model LoginModel
@inject IOptions<BrandingOptions> BrandingOptions

@{
    var branding = BrandingOptions.Value;
    var loginLogoUrl = !string.IsNullOrWhiteSpace(branding.LoginLogoPath)
        ? Url.Content(branding.LoginLogoPath)
        : string.Empty;
    ViewData["Title"] = "Log in";
}

<div class="container login-page">
    <div class="login-shell">
        <section class="login-brand-panel" aria-label="@branding.CompanyName" style="--login-logo-url: url('@loginLogoUrl');">
            <div class="login-brand-content">
                @if (!string.IsNullOrWhiteSpace(loginLogoUrl))
                {
                    <img src="@loginLogoUrl" class="login-brand-logo" alt="@branding.CompanyShortName logo" width="@branding.LoginLogoWidth" />
                }
                <div>
                    <div class="login-company-name">@branding.CompanyShortName</div>
                    <div class="login-application-name">@branding.ApplicationName</div>
                </div>
            </div>
            <div class="login-company-legal">@branding.LegalName</div>
        </section>

        <section class="login-form-panel">
            <div class="login-form-header">
                <h1>Sign in</h1>
                <p>Use your assigned username and password.</p>
            </div>

            <form id="account" method="post" autocomplete="off" class="login-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Input.Username"></label>
                    <div class="login-input-group">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Input.Username" class="form-control" id="username" placeholder="Username" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-danger small"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password"></label>
                    <div class="login-input-group">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Input.Password" class="form-control" placeholder="Password" type="password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check login-remember">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label"></label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary login-submit">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    <span>Log in</span>
                </button>

                @* Optional sign up link
                <div class="text-center mt-3">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Create an account</a>
                </div>
                *@
            </form>

            @if (Model.CompanyPortalLinks.Count != 0)
            {
                <div class="login-portals">
                    <div class="login-portals-header">
                        <span>Other company portals</span>
                    </div>
                    <div class="login-portal-list">
                        @foreach (var companyPortal in Model.CompanyPortalLinks)
                        {
                            <a class="login-portal-link"
                               href="@companyPortal.Url"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span>@companyPortal.Name</span>
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
