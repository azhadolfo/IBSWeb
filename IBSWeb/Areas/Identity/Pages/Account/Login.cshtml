@page
@using IBS.Utility
@using Microsoft.Extensions.Options
@model LoginModel
@inject IOptions<BrandingOptions> BrandingOptions

@{
    var branding = BrandingOptions.Value;
    var loginLogoUrl = !string.IsNullOrWhiteSpace(branding.LoginLogoPath)
        ? Url.Content(branding.LoginLogoPath)
        : string.Empty;
    ViewData["Title"] = "Log in";
}

<div class="container login-page">
    <div class="login-shell">
        <section class="login-brand-panel" aria-label="@branding.CompanyName" style="--login-logo-url: url('@loginLogoUrl');">
            <div class="login-brand-content">
                @if (!string.IsNullOrWhiteSpace(loginLogoUrl))
                {
                    <img src="@loginLogoUrl" class="login-brand-logo" alt="@branding.CompanyShortName logo" width="@branding.LoginLogoWidth" />
                }
                <div class="login-application-name">@branding.ApplicationName</div>
            </div>
            <div class="login-company-legal">@branding.LegalName</div>
        </section>

        <section class="login-form-panel">
            <div class="login-form-header">
                <div class="login-company-context">
                    <i class="bi bi-building-check" aria-hidden="true"></i>
                    <span>You are signing in to <strong>@branding.CompanyShortName</strong></span>
                </div>
                <h1>Welcome back</h1>
                <p>Sign in to the @branding.ApplicationName.</p>
            </div>

            <form id="account" method="post" autocomplete="off" class="login-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Input.Username"></label>
                    <div class="login-input-group">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Input.Username" class="form-control" id="username" placeholder="Username" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-danger small"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password"></label>
                    <div class="login-input-group">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Input.Password" class="form-control" id="password" placeholder="Password" type="password" />
                        <button type="button"
                                class="login-password-toggle"
                                id="password-toggle"
                                aria-label="Show password"
                                aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="login-options">
                    <div class="form-check login-remember">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Keep me signed in</label>
                    </div>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary login-submit">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    <span>Sign in to @branding.CompanyShortName</span>
                </button>
            </form>

            @if (Model.CompanyPortalLinks.Count != 0)
            {
                <div class="login-portals">
                    <div class="login-portals-header">
                        <strong>Not signing in to @branding.CompanyShortName?</strong>
                        <span>Choose another company portal</span>
                    </div>
                    <div class="login-portal-list">
                        @foreach (var companyPortal in Model.CompanyPortalLinks)
                        {
                            <a class="login-portal-link"
                               href="@companyPortal.Url"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span>@companyPortal.Name</span>
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const password = document.getElementById("password");
            const toggle = document.getElementById("password-toggle");

            toggle?.addEventListener("click", () => {
                const showPassword = password.type === "password";
                password.type = showPassword ? "text" : "password";
                toggle.setAttribute("aria-label", showPassword ? "Hide password" : "Show password");
                toggle.setAttribute("aria-pressed", showPassword.toString());
                toggle.querySelector("i")?.classList.toggle("bi-eye", !showPassword);
                toggle.querySelector("i")?.classList.toggle("bi-eye-slash", showPassword);
            });
        })();
    </script>
}
