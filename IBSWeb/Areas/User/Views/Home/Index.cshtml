                                            <span class="sidebar-item-ref">@item.ReferenceNo</span>
                                            <span class="sidebar-item-status">@item.DisplayStatus</span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="sidebar-empty">
                                <p class="sidebar-empty-text">No items pending your approval.</p>
                            </div>
