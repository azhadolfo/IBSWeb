@using Microsoft.AspNetCore.Identity
@model IBS.Models.Filpride.ViewModels.DashboardCountViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    var department = ViewBag.GetUserDepartment;
    ViewData["Title"] = "Dashboard";
    var selectedCompany = string.Empty;
    var selectedStation = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value;
        selectedStation = User.Claims.FirstOrDefault(c => c.Type == "StationCode")?.Value;
    }

    bool isAdmin = User.IsInRole("Admin");
    bool isHead = User.IsInRole("HeadApprover");
    bool isAccounting = User.IsInRole("AccountingManager") || User.IsInRole("ManagementAccountingManager");
    bool isFinance = User.IsInRole("FinanceManager");
    bool isOps = User.IsInRole("OperationManager");
    bool isCnc = User.IsInRole("CncManager");
    bool isPort = User.IsInRole("PortCoordinator");
    bool isCashier = User.IsInRole("Cashier");

    bool showPriority = isAdmin || isHead || isAccounting || isFinance || isOps || isCnc || isPort || isCashier;

    int fmTotal = Model.FMApprovalCount + Model.FMApprovalDMCount + Model.FMApprovalCMCount;
    int omTotal = Model.OMApprovalCOSCount + Model.OMApprovalDRCount + Model.OMApprovalPOCount;
}

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">

@if (!User.Identity!.IsAuthenticated)
{
    <div class="text-center mt-5">
        <a class="btn btn-primary btn-lg px-4 py-3" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="">
            Login <i class="bi bi-box-arrow-in-right ms-2"></i>
        </a>
    </div>
}
else
{
    if (selectedCompany == "Filpride")
    {
        <div class="dash">

            <header class="dash-header">
                <h1 class="dash-title">Welcome to Our Integrated Business System</h1>
                <p class="dash-subtitle">Effortlessly manage and optimize your business tasks.</p>
            </header>

            @if (showPriority)
            {
                <section class="pri-section">
                    <div class="section-header">
                        <span class="bar-primary"></span>
                        <h2 class="sec-title">Priority Approvals</h2>
                        <span class="sec-tag">Urgent Actions Required</span>
                    </div>
                    <div class="pri-grid">

                        @if (isAdmin || isHead || isFinance)
                        {
                            <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForFMApproval" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-green">
                                        <span class="material-symbols-outlined pri-icon">check_circle</span>
                                    </div>
                                    <span class="pri-label">FM Approval</span>
                                </div>
                                <span class="pri-count">@fmTotal.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isOps)
                        {
                            <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForOMApproval" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-blue">
                                        <span class="material-symbols-outlined pri-icon">verified</span>
                                    </div>
                                    <span class="pri-label">OM Approval</span>
                                </div>
                                <span class="pri-count">@omTotal.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isAccounting)
                        {
                            <a href="@Url.Action("Index", "CheckVoucherNonTradeInvoice", new { area = "Filpride", filterType = "ForApproval" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-red">
                                        <span class="material-symbols-outlined pri-icon">assignment_late</span>
                                    </div>
                                    <span class="pri-label">CV Approval</span>
                                </div>
                                <span class="pri-count">@Model.CheckVoucherNonTradeInvoiceForApprovalCount.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isAccounting)
                        {
                            <a href="@Url.Action("Index", "JournalVoucher", new { area = "Filpride", filterType = "ForApproval" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-red">
                                        <span class="material-symbols-outlined pri-icon">assignment</span>
                                    </div>
                                    <span class="pri-label">JV Approval</span>
                                </div>
                                <span class="pri-count">@Model.JournalVoucherForApprovalCount.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isCnc)
                        {
                            <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForCNCApproval" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-gray">
                                        <span class="material-symbols-outlined pri-icon">fact_check</span>
                                    </div>
                                    <span class="pri-label">CNC Approval</span>
                                </div>
                                <span class="pri-count">@Model.CNCApprovalCount.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isOps || isPort)
                        {
                            <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "InTransit" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-teal">
                                        <span class="material-symbols-outlined pri-icon">local_shipping</span>
                                    </div>
                                    <span class="pri-label">Pending Delivery</span>
                                </div>
                                <span class="pri-count">@Model.InTransitCount.ToString("N0")</span>
                            </a>
                        }

                        @if (isAdmin || isHead || isFinance || isCashier)
                        {
                            <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "ForInvoice" })" class="pri-card">
                                <div class="pri-card-body">
                                    <div class="pri-icon-wrap pri-icon-green">
                                        <span class="material-symbols-outlined pri-icon">receipt_long</span>
                                    </div>
                                    <span class="pri-label">For Invoicing</span>
                                </div>
                                <span class="pri-count">@Model.ForInvoiceCount.ToString("N0")</span>
                            </a>
                        }

                    </div>
                </section>
            }

            <section class="flow-section">
                <h2 class="flow-heading">
                    <span class="bar-secondary"></span>
                    Order Processing Pipeline
                </h2>
                <div class="pipe-grid">

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForMarketingApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">campaign</span>
                            </div>
                            <span class="pipe-count">@Model.MarketingApprovalCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">Marketing Approval</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForCNCApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">fact_check</span>
                            </div>
                            <span class="pipe-count">@Model.CNCApprovalCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">CNC Approval</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForAppointSupplier" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-gray">
                                <span class="material-symbols-outlined pipe-icon">person_add</span>
                            </div>
                            <span class="pipe-count">@Model.SupplierAppointmentCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">Supplier Appointment</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForATLBooking" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">event_available</span>
                            </div>
                            <span class="pipe-count">@Model.ATLBookingCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">ATL Booking</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForOMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">verified</span>
                            </div>
                            <span class="pipe-count">@Model.OMApprovalCOSCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">OM Approval (COS)</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForFMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">check_circle</span>
                            </div>
                            <span class="pipe-count">@Model.FMApprovalCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">FM Approval (COS)</span>
                    </a>

                    <a href="@Url.Action("Index", "CustomerOrderSlip", new { area = "Filpride", filterType = "ForDR" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">description</span>
                            </div>
                            <span class="pipe-count">@Model.DRCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">For DR</span>
                    </a>

                </div>
            </section>

            <section class="flow-section">
                <h2 class="flow-heading flow-heading-bordered">
                    <span class="bar-primary"></span>
                    Delivery &amp; Procurement
                </h2>
                <div class="pipe-grid">

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "ForOMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">verified</span>
                            </div>
                            <span class="pipe-count">@Model.OMApprovalDRCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">OM Approval (DR)</span>
                    </a>

                    <a href="@Url.Action("Index", "PurchaseOrder", new { area = "Filpride", filterType = "ForOMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">verified</span>
                            </div>
                            <span class="pipe-count">@Model.OMApprovalPOCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">OM Approval (PO)</span>
                    </a>

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "InTransit" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-gray">
                                <span class="material-symbols-outlined pipe-icon">local_shipping</span>
                            </div>
                            <span class="pipe-count">@Model.InTransitCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">Pending Delivery</span>
                    </a>

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "RecordLiftingDate" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">calendar_add_on</span>
                            </div>
                            <span class="pipe-count">@Model.RecordLiftingDateCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">Record Lifting Date</span>
                    </a>

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "ForInvoice" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">receipt_long</span>
                            </div>
                            <span class="pipe-count">@Model.ForInvoiceCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">For Invoicing</span>
                    </a>

                    <a href="@Url.Action("Index", "ReceivingReport", new { area = "Filpride", filterType = "RecordSupplierDetails" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">assignment_ind</span>
                            </div>
                            <span class="pipe-count">@Model.RecordSupplierDetails.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">Record Supplier Details</span>
                    </a>

                </div>
            </section>

            <section class="flow-section">
                <h2 class="flow-heading flow-heading-bordered">
                    <span class="bar-secondary"></span>
                    Finance &amp; Accounting
                </h2>
                <div class="pipe-grid pipe-grid-4">

                    <a href="@Url.Action("Index", "DebitMemo", new { area = "Filpride", filterType = "ForFMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">check_circle</span>
                            </div>
                            <span class="pipe-count">@Model.FMApprovalDMCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">FM Approval (Debit Memo)</span>
                    </a>

                    <a href="@Url.Action("Index", "CreditMemo", new { area = "Filpride", filterType = "ForFMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-green">
                                <span class="material-symbols-outlined pipe-icon">check_circle</span>
                            </div>
                            <span class="pipe-count">@Model.FMApprovalCMCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">FM Approval (Credit Memo)</span>
                    </a>

                    @if (isAdmin || isHead || isAccounting)
                    {
                        <a href="@Url.Action("Index", "CheckVoucherNonTradeInvoice", new { area = "Filpride", filterType = "ForApproval" })" class="pipe-card">
                            <div class="pipe-card-top">
                                <div class="pipe-icon-wrap pipe-icon-green">
                                    <span class="material-symbols-outlined pipe-icon">assignment_late</span>
                                </div>
                                <span class="pipe-count">@Model.CheckVoucherNonTradeInvoiceForApprovalCount.ToString("N0")</span>
                            </div>
                            <span class="pipe-label">CV Approval</span>
                        </a>

                        <a href="@Url.Action("Index", "JournalVoucher", new { area = "Filpride", filterType = "ForApproval" })" class="pipe-card">
                            <div class="pipe-card-top">
                                <div class="pipe-icon-wrap pipe-icon-green">
                                    <span class="material-symbols-outlined pipe-icon">assignment</span>
                                </div>
                                <span class="pipe-count">@Model.JournalVoucherForApprovalCount.ToString("N0")</span>
                            </div>
                            <span class="pipe-label">JV Approval</span>
                        </a>
                    }

                </div>
            </section>

        </div>
    }
}

<style>
    :root {
        --primary: #001919;
        --on-surface: #0b1c30;
        --on-surface-variant: #414848;
        --secondary: #006c47;
        --outline-variant: #c1c8c7;
        --surface-container-lowest: #ffffff;
        --secondary-container: #8bf8bf;
        --error: #ba1a1a;
        --error-container: #ffdad6;
        --surface-variant: #d3e4fe;
        --surface: #f8f9ff;
    }

    .dash {
        color: var(--on-surface);
        font-family: 'Inter', sans-serif;
        padding: 1.25rem 2rem;
        min-height: calc(100vh - var(--navbar-height, 56px));
    }

    .dash-header { margin-bottom: 3rem; }

    .dash-title {
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 48px;
        line-height: 56px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--primary);
        margin: 0 0 0.25rem 0;
    }

    .dash-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        line-height: 28px;
        font-weight: 400;
        color: var(--on-surface-variant);
        margin: 0;
    }

    .pri-section { margin-bottom: 3rem; }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .bar-primary, .bar-secondary {
        display: inline-block;
        width: 4px;
        height: 1rem;
        border-radius: 2px;
        flex-shrink: 0;
    }
    .bar-primary { background: var(--primary); }
    .bar-secondary { background: var(--secondary); }

    .sec-title {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--primary);
        margin: 0;
    }

    .sec-tag {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--on-surface-variant);
        margin-left: auto;
    }

    .pri-grid {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 1.25rem;
    }
    @@media (min-width: 768px) { .pri-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (min-width: 1024px) { .pri-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (min-width: 1280px) { .pri-grid { grid-template-columns: repeat(4, 1fr); } }

    .pri-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--surface-container-lowest);
        border: 1px solid var(--outline-variant);
        border-radius: 0.75rem;
        padding: 1.5rem;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0px 4px 20px rgba(15, 46, 46, 0.04);
        cursor: pointer;
    }
    .pri-card:hover {
        box-shadow: 0px 8px 24px rgba(15, 46, 46, 0.08);
        border-color: var(--secondary);
        text-decoration: none;
    }

    .pri-card-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pri-icon-wrap {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pri-icon-wrap.pri-icon-green { background: var(--secondary-container); color: var(--secondary); }
    .pri-icon-wrap.pri-icon-blue { background: var(--surface-variant); color: var(--primary); }
    .pri-icon-wrap.pri-icon-red { background: var(--error-container); color: var(--error); }
    .pri-icon-wrap.pri-icon-gray { background: #e8edee; color: #192E2F; }
    .pri-icon-wrap.pri-icon-teal { background: #e0e9ea; color: #3A595C; }

    .pri-icon {
        font-size: 1.25rem;
        font-variation-settings: 'FILL' 1;
    }

    .pri-label {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        line-height: 20px;
        font-weight: 500;
        color: var(--on-surface-variant);
    }

    .pri-count {
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 28px;
        line-height: 32px;
        font-weight: 500;
        color: var(--primary);
    }

    .flow-section { margin-bottom: 3rem; }

    .flow-heading {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1.5rem 0;
    }
    .flow-heading-bordered {
        padding-top: 1.5rem;
        border-top: 1px solid var(--outline-variant);
    }

    .pipe-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    @@media (min-width: 768px) { .pipe-grid { grid-template-columns: repeat(4, 1fr); } }
    @@media (min-width: 1024px) { .pipe-grid { grid-template-columns: repeat(6, 1fr); } }

    .pipe-grid-4 {
        grid-template-columns: repeat(2, 1fr);
    }
    @@media (min-width: 768px) { .pipe-grid-4 { grid-template-columns: repeat(4, 1fr); } }

    .pipe-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--surface-container-lowest);
        border: 1px solid var(--outline-variant);
        border-radius: 0.5rem;
        padding: 1rem;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0px 4px 20px rgba(15, 46, 46, 0.04);
        cursor: pointer;
        height: 100%;
        min-height: 100px;
    }
    .pipe-card:hover {
        box-shadow: 0px 8px 24px rgba(15, 46, 46, 0.08);
        border-color: var(--secondary);
        text-decoration: none;
    }

    .pipe-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .pipe-icon-wrap {
        width: 2rem;
        height: 2rem;
        border-radius: 0.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pipe-icon-wrap.pipe-icon-green { background: var(--secondary-container); color: var(--secondary); }
    .pipe-icon-wrap.pipe-icon-gray { background: var(--surface-variant); color: var(--primary); }

    .pipe-icon {
        font-size: 0.875rem;
        font-variation-settings: 'FILL' 1;
    }

    .pipe-count {
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 20px;
        line-height: 28px;
        font-weight: 600;
        color: var(--primary);
    }

    .pipe-label {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--on-surface-variant);
    }

    @@media (max-width: 767px) {
        .dash { padding: 0.75rem 1rem; }
        .dash-title { font-size: 32px; line-height: 40px; }
        .dash-subtitle { font-size: 16px; line-height: 24px; }
        .pri-card { padding: 1rem; }
        .pri-icon-wrap { width: 2rem; height: 2rem; }
        .pri-icon { font-size: 1rem; }
        .pri-count { font-size: 22px; line-height: 28px; }
