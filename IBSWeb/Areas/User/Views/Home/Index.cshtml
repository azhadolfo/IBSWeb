                <div class="pipe-grid">

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "ForOMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-blue">
                                <span class="material-symbols-outlined pipe-icon">verified</span>
                            </div>
                            <span class="pipe-count">@Model.OMApprovalDRCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">OM Approval (DR)</span>
                    </a>

                    <a href="@Url.Action("Index", "PurchaseOrder", new { area = "Filpride", filterType = "ForOMApproval" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-blue">
                                <span class="material-symbols-outlined pipe-icon">verified</span>
                            </div>
                            <span class="pipe-count">@Model.OMApprovalPOCount.ToString("N0")</span>
                        </div>
                        <span class="pipe-label">OM Approval (PO)</span>
                    </a>

                    <a href="@Url.Action("Index", "DeliveryReceipt", new { area = "Filpride", filterType = "InTransit" })" class="pipe-card">
                        <div class="pipe-card-top">
                            <div class="pipe-icon-wrap pipe-icon-gray">
