<script>
    function switchSidebarTab(tab) {
        document.querySelectorAll('#sidebar .sidebar-tab, #mobile-sidebar .sidebar-tab').forEach(function(t) {
            var isActive = t.dataset.tab === tab;
            t.classList.toggle('active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        document.querySelectorAll('#sidebar .sidebar-tab-content, #mobile-sidebar .sidebar-tab-content').forEach(function(c) {
            c.style.display = c.id === 'tab-' + tab || c.id === 'mob-tab-' + tab ? 'block' : 'none';
        });
    }
</script>
