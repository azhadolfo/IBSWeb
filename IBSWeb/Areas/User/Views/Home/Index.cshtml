                    {
                        <div class="sidebar-list">
                            @foreach (var item in Model.MySubmissions)
                            {
                                <a href="@item.SidebarUrl" class="sidebar-item">
                                    <span class="sidebar-item-type sidebar-type-@item.Type.ToLowerInvariant()">@item.Type</span>
                                    <div class="sidebar-item-body">
                                        <span class="sidebar-item-ref">@item.ReferenceNo</span>
                                        <span class="sidebar-item-status">@item.DisplayStatus</span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sidebar-empty">
                            <p class="sidebar-empty-text">No pending submissions.</p>
                        </div>
                    }
                </div>
            </div>

