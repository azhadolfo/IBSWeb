}



<style>
    .container {
        max-width: 100% !important;
    }
    :root {
        --primary: #001919;
        --on-surface: #0b1c30;
        --on-surface-variant: #414848;
        --secondary: #006c47;
        --outline-variant: #c1c8c7;
        --surface-container-lowest: #ffffff;
        --secondary-container: #8bf8bf;
        --error: #ba1a1a;
        --error-container: #ffdad6;
        --surface-variant: #d3e4fe;
        --surface: #f8f9ff;
    }

    .dash-layout {
        display: flex;
        gap: 0;
        min-height: calc(100vh - var(--navbar-height, 56px));
    }

    .dash-main {
        flex: 1;
        min-width: 0;
        color: var(--on-surface);
        font-family: 'Inter', sans-serif;
        padding: 1.25rem 2rem;
    }

    .dash-header { margin-bottom: 2rem; }

    .dash-title {
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 48px;
        line-height: 56px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--primary);
        margin: 0 0 0.25rem 0;
    }

    .dash-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        line-height: 28px;
        font-weight: 400;
        color: var(--on-surface-variant);
        margin: 0;
    }

    .pri-section { margin-bottom: 3rem; }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .bar-primary, .bar-secondary {
        display: inline-block;
        width: 4px;
        height: 1rem;
        border-radius: 2px;
        flex-shrink: 0;
    }
    .bar-primary { background: var(--primary); }
    .bar-secondary { background: var(--secondary); }

    .sec-title {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--primary);
        margin: 0;
    }

    .sec-tag {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--on-surface-variant);
        margin-left: auto;
    }

    .pri-grid {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 1.25rem;
    }
    @@media (min-width: 768px) { .pri-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (min-width: 1024px) { .pri-grid { grid-template-columns: repeat(3, 1fr); } }
