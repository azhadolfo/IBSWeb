        </div>
    }
    else
    {
        <div class="dash-layout">
            <div class="dash-main">
                <header class="dash-header">
                    <h1 class="dash-title">Welcome to Our Integrated Business System</h1>
                    <p class="dash-subtitle">Please select a company to access the dashboard.</p>
                </header>
            </div>
        </div>
