            <div class="mobile-sidebar" id="mobile-sidebar">
                <div class="sidebar-tabs" role="tablist">
                    @if (Model.ShowPriority)
                    {
                        <button class="sidebar-tab active" data-tab="for-approval" onclick="switchSidebarTab('for-approval')" role="tab" aria-selected="true" aria-controls="mob-tab-for-approval">For Approval</button>
                    }
                    <button class="sidebar-tab @(!Model.ShowPriority ? "active" : "")" data-tab="my-submissions" onclick="switchSidebarTab('my-submissions')" role="tab" aria-selected="@(!Model.ShowPriority ? "true" : "false")" aria-controls="mob-tab-my-submissions">My Submissions</button>
