                    <button class="sidebar-tab @(!Model.ShowPriority ? "active" : "")" data-tab="my-submissions" onclick="switchSidebarTab('my-submissions')" role="tab" aria-selected="@(!Model.ShowPriority ? "true" : "false")" aria-controls="tab-my-submissions">My Submissions</button>
