@using IBS.Models.Enums
@using IBS.Utility.Constants
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Identity
@inject IOptions<BrandingOptions> BrandingOptions
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var branding = BrandingOptions.Value;
    var isLoginPage = Context.Request.Path.Value?.StartsWith("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase) == true;
    var selectedCompany = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value ?? string.Empty;
    }
    var userName = UserManager.GetUserName(User);

    var assembly = typeof(Program).Assembly;
    var informationalVersion = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(assembly)?
        .InformationalVersion;
    var appVersion = informationalVersion?.Split('+')[0]
                     ?? assembly.GetName().Version?.ToString()
                     ?? "0.0.0";
    var currentYear = DateTime.UtcNow.Year;
    var copyrightYears = currentYear > 2024
        ? $"2024-{currentYear}"
        : "2024";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @branding.CompanyShortName</title>
    <link id="favicon-light" href="@Url.Content(branding.FaviconLightPath)" rel="shortcut icon" type="image/svg+xml" />
    <link id="favicon-dark" href="@Url.Content(branding.FaviconDarkPath)" rel="shortcut icon" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css">
    <link rel="stylesheet" href="~/IBSWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> <!--Select2 plug ins-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.1/css/dataTables.dataTables.css" /> <!--Data tables plug ins-->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.1.0/css/buttons.dataTables.min.css"> <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.css" /><!--Data table pug-in-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Modern Typography & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Hanken+Grotesk:wght@600;700;800&display=block" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet" />
    <!-- Modern Mega-Menu Navbar Styles -->
    <link rel="stylesheet" href="~/css/modern-navbar.css" asp-append-version="true" />

    <style>
        :root {
            --brand-primary: @branding.PrimaryColor;
            --brand-primary-hover: @branding.PrimaryHoverColor;
            --brand-secondary: @branding.SecondaryColor;
            --brand-accent: @branding.AccentColor;
        }
    </style>
</head>
<body class="@(isLoginPage ? "login-layout" : "mnav-enabled")" data-selected-company="@selectedCompany">
    @if (!isLoginPage)
    {
        <partial name="_Navbar" />
    }

    <div class="container">
        <partial name="_Notification" />
        <main role="main">
            <input type="hidden" id="hfUsername" value="@userName" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-primary text-light">
        <div class="container text-center">
            &copy; @copyrightYears - @branding.CompanyName <i class="bi bi-r-circle"></i> &middot; @($"v{appVersion}")
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script><!--select 2 scripts-->
    <script src="https://cdn.datatables.net/2.0.1/js/dataTables.js"></script><!--data tables scripts-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><!--sweet alert scripts-->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/notification.js"></script>
    <script src="~/js/spinner.js"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/select.dataTables.js"></script>
    <!-- Modern Navbar Controller -->
    <script src="~/js/modern-navbar.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
    $(document).ajaxError(function (_, xhr) {
        if (xhr.status !== 401) {
            return;
        }

        const loginUrl = xhr.getResponseHeader('X-Login-Url');
        if (loginUrl) {
            window.location.assign(loginUrl);
        }
    });

    $(document).ready(function () {
        // Check if the user is logged in
        if ($('#hfUsername').length && $('#hfUsername').val() !== "") {
            // Function to fetch and update notification count
            function updateNotificationCount() {
                $.ajax({
                    url: '@Url.Action("GetNotificationCount", "Notification", new { area = "User" })',
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (count) {
                        $('#notificationCount').text(count);
                    },
                    error: function () {
                        console.error("Error fetching notification count");
                    }
                });
            }

            // Initial load
            updateNotificationCount();

            // Optional: Poll every 30 seconds to update count
            setInterval(updateNotificationCount, 30000); // 30,000 ms = 30 seconds
        }
    });
    </script>
    <script>
        const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        function updateFavicon(e) {
            const faviconLight = document.getElementById('favicon-light');
            const faviconDark = document.getElementById('favicon-dark');
            if (!faviconLight || !faviconDark) return;

            if (e.matches) {
                faviconDark.rel = 'shortcut icon';
                faviconLight.rel = '';
            } else {
                faviconDark.rel = '';
                faviconLight.rel = 'shortcut icon';
            }
        }

        // Initial check
        updateFavicon(darkModeMediaQuery);

        // Listen for changes
        darkModeMediaQuery.addEventListener('change', updateFavicon);
    </script>
</body>
</html>
