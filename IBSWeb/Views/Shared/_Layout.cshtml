
@using IBS.Models.Enums
@using IBS.Utility.Constants
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Identity
@inject IOptions<BrandingOptions> BrandingOptions
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var branding = BrandingOptions.Value;
    var isLoginPage = Context.Request.Path.Value?.StartsWith("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase) == true;
    var selectedCompany = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value;
    }
    var userDepartment = ViewBag.GetUserDepartment;
    var userName = UserManager.GetUserName(this.User);

    var assembly = typeof(Program).Assembly;
    var informationalVersion = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(assembly)?
        .InformationalVersion;
    var appVersion = informationalVersion?.Split('+')[0]
                     ?? assembly.GetName().Version?.ToString()
                     ?? "0.0.0";
    var currentYear = DateTime.UtcNow.Year;
    var copyrightYears = currentYear > 2024
        ? $"2024-{currentYear}"
        : "2024";
}

