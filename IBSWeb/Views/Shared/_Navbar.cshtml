@* _Navbar.cshtml
   Expanding Connected Column-Deck Navbar partial for IBSWeb.
*@
@using IBS.Models.Enums
@using IBS.Utility.Constants
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Identity
@inject IOptions<BrandingOptions> BrandingOptions
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var branding = BrandingOptions.Value;
    var selectedCompany = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value ?? string.Empty;
    }

    var userDepartment = ViewBag.GetUserDepartment as string ?? string.Empty;
    var userFullName = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value
                       ?? (await UserManager.GetUserAsync(User))?.Name
                       ?? UserManager.GetUserName(User);
}

<!-- Overlay for outside click closing -->
<div id="mnav-overlay"></div>

<header id="modern-navbar" role="banner" aria-label="Main Navigation">

    <!-- ── Hamburger (Mobile) ── -->
    <button class="mnav-hamburger" id="mnav-hamburger" aria-label="Toggle navigation menu" aria-controls="mnav-drawer" aria-expanded="false" type="button">
        <span class="material-symbols-outlined">menu</span>
    </button>

    <!-- ── Brand ── -->
    <a class="mnav-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <img src="@Url.Content(branding.NavbarLogoPath)" alt="@branding.CompanyShortName logo" width="@branding.NavbarLogoWidth" height="@branding.NavbarLogoHeight" />
        <span class="d-none d-sm-inline">@branding.CompanyShortName</span>
    </a>

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- ── Mobile Drawer Overlay ── -->
        <div class="mnav-drawer-overlay" id="mnav-drawer-overlay"></div>

        <!-- ── Mobile Drawer ── -->
        <nav class="mnav-drawer" id="mnav-drawer" aria-label="Mobile navigation">
            <div class="mnav-list"></div>
        </nav>

        <!-- ── Desktop Navigation ── -->
        <nav class="mnav-nav-area" aria-label="Main menu">
            <ul class="mnav-list" role="menubar">

                <!-- Home -->
                <li class="mnav-item" role="none">
                    <a class="mnav-trigger" asp-area="User" asp-controller="Home" asp-action="Index" role="menuitem">
                        <span class="material-symbols-outlined">home</span>
                        <span>Home</span>
                    </a>
                </li>

