                            {
                                <!-- Col 2: Filpride Master Records -->
                                <div class="mnav-col" data-col-level="2" data-col-id="mf-company-records" data-parent-col="mf-root" style="display:none;">
                                    <div class="mnav-col-header">@branding.CompanyShortName Records</div>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="Customer" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">person</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Customer</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="CustomerBranch" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">store</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Customer Branch</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="Supplier" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">local_shipping</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Supplier</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="BankAccount" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">account_balance</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Bank Account</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="Service" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">design_services</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Service</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="ChartOfAccount" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">list_alt</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Chart of Accounts</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="PickupPoint" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">pin_drop</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Pickup Points</div></div></div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="PaymentTerm" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">schedule</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Payment Terms</div></div></div>
                                    </a>
                                </div>
                            }

                            <!-- Col 2: General Master Records -->
                            <div class="mnav-col" data-col-level="2" data-col-id="mf-general-records" data-parent-col="mf-root" style="display:none;">
                                <div class="mnav-col-header">General Records</div>
                                <a class="mnav-col-item" asp-area="User" asp-controller="Company" asp-action="Index" role="menuitem">
                                    <div class="mnav-col-item-content"><span class="material-symbols-outlined">domain</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Company</div></div></div>
                                </a>
                                <a class="mnav-col-item" asp-area="User" asp-controller="Product" asp-action="Index" role="menuitem">
                                    <div class="mnav-col-item-content"><span class="material-symbols-outlined">category</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Product</div></div></div>
                                </a>
                                <div class="mnav-divider"></div>
                                <a class="mnav-col-item" asp-area="Admin" asp-controller="AppRole" asp-action="Index" role="menuitem">
                                    <div class="mnav-col-item-content"><span class="material-symbols-outlined">security</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Role</div></div></div>
                                </a>
                                <a class="mnav-col-item" asp-area="Admin" asp-controller="User" asp-action="Index" role="menuitem">
                                    <div class="mnav-col-item-content"><span class="material-symbols-outlined">manage_accounts</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">User</div></div></div>
                                </a>
                                @if (selectedCompany == "Filpride")
                                {
                                    <div class="mnav-divider"></div>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="DepartmentAccessConfiguration" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content"><span class="material-symbols-outlined">lock_person</span><div class="mnav-col-item-text"><div class="mnav-col-item-title">Department Access</div></div></div>
                                    </a>
                                }
                            </div>
                        </div>
                    </li>

                    @if (selectedCompany == "Filpride")
                    {
                        <!-- Utility (Admin) -->
                        <li class="mnav-item" data-nav-deck role="none">
                            <button class="mnav-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                                <span>Utility</span>
                                <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                            </button>
                            <div class="mnav-column-deck" role="menu">
                                <div class="mnav-col" data-col-level="1" data-col-id="util-root">
                                    <div class="mnav-col-header">Utility Operations</div>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="TransactionMasterControl" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content">
                                            <span class="material-symbols-outlined">tune</span>
                                            <div class="mnav-col-item-text">
                                                <div class="mnav-col-item-title">Entries Master Control</div>
                                                <div class="mnav-col-item-sub">Journal entries controller</div>
                                            </div>
                                        </div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="TransactionMasterControl" asp-action="BatchReJournal" role="menuitem">
                                        <div class="mnav-col-item-content">
                                            <span class="material-symbols-outlined">replay</span>
                                            <div class="mnav-col-item-text">
                                                <div class="mnav-col-item-title">Batch ReJournal</div>
                                                <div class="mnav-col-item-sub">Bulk re-journaling tool</div>
                                            </div>
                                        </div>
                                    </a>

                                    <div class="mnav-divider"></div>

                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="MonthlyPeriod" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content">
                                            <span class="material-symbols-outlined">calendar_month</span>
                                            <div class="mnav-col-item-text">
                                                <div class="mnav-col-item-title">Monthly Period</div>
                                                <div class="mnav-col-item-sub">Accounting closure periods</div>
                                            </div>
                                        </div>
                                    </a>
                                    <a class="mnav-col-item" asp-area="Filpride" asp-controller="PostedPeriod" asp-action="Index" role="menuitem">
                                        <div class="mnav-col-item-content">
                                            <span class="material-symbols-outlined">lock_clock</span>
                                            <div class="mnav-col-item-text">
                                                <div class="mnav-col-item-title">Posted Period</div>
                                                <div class="mnav-col-item-sub">Transaction lock periods</div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                }

            </ul>
        </nav>

        <!-- ── Right Controls ── -->
        <div class="mnav-right">
            <!-- Spotlight Search -->
            <div class="mnav-search-wrap">
                <span class="material-symbols-outlined mnav-search-icon" aria-hidden="true">search</span>
                <label for="mnav-search-input" class="visually-hidden">Search</label>
                <input class="mnav-search" id="mnav-search-input" type="search" placeholder="Press / to search..." aria-label="Search" />
            </div>

            <!-- SignalR Notification Bell -->
            <a href="@Url.Action("Index", "Notification", new { area = "User" })" class="mnav-icon-btn position-relative" title="Notifications" aria-label="Notifications">
                <span class="material-symbols-outlined">notifications</span>
                <span id="notificationCount" class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill mnav-notification-badge">0</span>
            </a>

            <!-- User Menu -->
            <div class="mnav-user-dropdown">
                <button class="mnav-user-trigger" id="mnav-user-trigger" type="button" aria-haspopup="true" aria-expanded="false" title="User menu">
                    <span class="material-symbols-outlined mnav-avatar-icon">account_circle</span>
                    <span class="mnav-user-name">@(userFullName ?? "User")</span>
                    <span class="material-symbols-outlined mnav-chevron">expand_more</span>
                </button>
                <div class="mnav-dropdown-menu" id="mnav-dropdown-menu">
                    <div class="mnav-dropdown-header">
                        <span class="material-symbols-outlined" style="font-size:32px;">account_circle</span>
                        <div>
                            <div class="mnav-dropdown-name">@(userFullName ?? "User")</div>
                            @if (!string.IsNullOrEmpty(selectedCompany))
                            {
                                <div class="mnav-dropdown-role">@selectedCompany.ToUpper()</div>
                            }
                        </div>
                    </div>
                    <div class="mnav-dropdown-divider"></div>

                    <a class="mnav-dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                        <span class="material-symbols-outlined">password</span>
                        <span>Change Password</span>
                    </a>

                    <div class="mnav-dropdown-divider"></div>

                    <form id="logoutForm" class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="mnav-dropdown-item mnav-dropdown-danger">
                            <span class="material-symbols-outlined">logout</span>
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</header>
